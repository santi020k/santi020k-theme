{
  "name": "@santi020k/santi020k-theme-root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "pnpm run site:dev",
    "dev:vscode": "pnpm run build:themes",
    "dev:chrome": "pnpm --filter santi020k-chrome-theme run dev",
    "dev:chrome:dark": "pnpm --filter santi020k-chrome-theme run dev:dark",
    "dev:chrome:light": "pnpm --filter santi020k-chrome-theme run dev:light",
    "build": "turbo run build",
    "build:chrome-theme": "pnpm --filter santi020k-chrome-theme run build",
    "build:themes": "pnpm --filter santi020k-theme run build",
    "build:zed": "pnpm --filter santi020k-zed-theme run build",
    "validate": "pnpm run typecheck && pnpm run build && pnpm run lint:spell && pnpm run validate:themes && pnpm run validate:marketplace && pnpm run validate:chrome && pnpm run validate:terminal && pnpm run validate:zed && pnpm run validate:codex && pnpm run report:accessibility && pnpm run validate:seo && pnpm run test && pnpm run lint && pnpm run lint:knip && pnpm run package:extension",
    "pretest": "pnpm run build:themes",
    "test": "vitest run packages/santi020k-theme/tests packages/santi020k-terminal-theme/tests apps/vscode-website/tests",
    "sync:website-version": "pnpm --filter @santi020k/santi020k-vscode-theme-website run sync:website-version",
    "validate:links": "node scripts/check-website-links.mjs",
    "validate:seo": "node scripts/validate-website-seo.mjs",
    "validate:themes": "pnpm --filter santi020k-theme run validate:themes",
    "validate:marketplace": "pnpm --filter santi020k-theme run validate:marketplace",
    "validate:chrome": "pnpm --filter santi020k-chrome-theme run validate",
    "validate:terminal": "pnpm --filter santi020k-terminal-theme run validate",
    "validate:zed": "pnpm --filter santi020k-zed-theme run validate",
    "validate:codex": "pnpm --filter santi020k-codex-theme run validate",
    "lint": "eslint . --cache --no-warn-ignored --max-warnings=0",
    "lint:fix": "eslint . --cache --fix --no-warn-ignored --max-warnings=0",
    "lint:spell": "cspell \"**\" --gitignore --cache --show-suggestions --show-context",
    "lint:knip": "knip",
    "typecheck": "pnpm --filter './apps/*' exec astro check --minimumFailingSeverity warning && pnpm exec tsc -p packages/theme-core/tsconfig.json && pnpm exec tsc -p packages/theme/tsconfig.json && pnpm exec tsc -p packages/santi020k-terminal-theme/tsconfig.json",
    "package": "pnpm run package:extension",
    "package:extension": "pnpm --filter santi020k-theme run package",
    "package:chrome": "pnpm --filter santi020k-chrome-theme run package",
    "publish": "pnpm --filter santi020k-theme run publish",
    "publish:npm": "node scripts/publish-npm-packages.mjs",
    "publish:chrome": "pnpm --filter santi020k-chrome-theme run publish:webstore",
    "release": "pnpm run validate && pnpm run publish:npm && pnpm --filter santi020k-theme run release",
    "release:npm": "pnpm run publish:npm",
    "release:chrome": "pnpm --filter santi020k-chrome-theme run release",
    "release:tag": "pnpm --filter santi020k-theme run release:tag",
    "release:terminal:tag": "node scripts/ensure-terminal-release-tag.mjs",
    "generate:og": "node scripts/generate-og-images.mjs",
    "generate:vscode-previews": "node scripts/generate-vscode-preview-assets.mjs",
    "report:accessibility": "node scripts/generate-accessibility-report.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm --filter santi020k-chrome-theme run sync:manifest-version && pnpm --filter santi020k-zed-theme run sync:extension-version && pnpm install --lockfile-only && pnpm run sync:website-version",
    "site:dev": "pnpm --filter @santi020k/santi020k-theme-website run dev",
    "sites:dev": "pnpm --parallel --filter @santi020k/santi020k-theme-website --filter @santi020k/santi020k-vscode-theme-website --filter @santi020k/santi020k-chrome-theme-website --filter @santi020k/santi020k-terminal-theme-website --filter @santi020k/santi020k-zed-theme-website --filter @santi020k/santi020k-codex-theme-website run dev",
    "site:build": "pnpm --filter @santi020k/santi020k-theme-website run build",
    "site:preview": "pnpm --filter @santi020k/santi020k-theme-website run preview",
    "site:vscode:dev": "pnpm --filter @santi020k/santi020k-vscode-theme-website run dev",
    "site:vscode:build": "pnpm --filter @santi020k/santi020k-vscode-theme-website run build",
    "site:vscode:preview": "pnpm --filter @santi020k/santi020k-vscode-theme-website run preview",
    "site:chrome:dev": "pnpm --filter @santi020k/santi020k-chrome-theme-website run dev",
    "site:chrome:build": "pnpm --filter @santi020k/santi020k-chrome-theme-website run build",
    "site:chrome:preview": "pnpm --filter @santi020k/santi020k-chrome-theme-website run preview",
    "site:terminal:dev": "pnpm --filter @santi020k/santi020k-terminal-theme-website run dev",
    "site:terminal:build": "pnpm --filter @santi020k/santi020k-terminal-theme-website run build",
    "site:terminal:preview": "pnpm --filter @santi020k/santi020k-terminal-theme-website run preview",
    "site:zed:dev": "pnpm --filter @santi020k/santi020k-zed-theme-website run dev",
    "site:zed:build": "pnpm --filter @santi020k/santi020k-zed-theme-website run build",
    "site:zed:preview": "pnpm --filter @santi020k/santi020k-zed-theme-website run preview",
    "site:codex:dev": "pnpm --filter @santi020k/santi020k-codex-theme-website run dev",
    "site:codex:build": "pnpm --filter @santi020k/santi020k-codex-theme-website run build",
    "site:codex:preview": "pnpm --filter @santi020k/santi020k-codex-theme-website run preview",
    "prepare": "husky",
    "pre-commit": "lint-staged",
    "pre-push": "pnpm run validate",
    "commit": "commitprompt"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "@astrojs/ts-plugin": "catalog:",
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@santi020k/commitprompt": "catalog:",
    "@santi020k/eslint-config-astro": "catalog:",
    "@santi020k/eslint-config-basic": "catalog:",
    "@santi020k/eslint-config-extensions": "catalog:",
    "@santi020k/eslint-config-formats": "catalog:",
    "@santi020k/eslint-config-libraries": "catalog:",
    "@santi020k/eslint-config-testing": "catalog:",
    "@santi020k/eslint-config-tools": "catalog:",
    "@types/node": "catalog:",
    "@vscode/vsce": "catalog:",
    "cspell": "catalog:",
    "eslint": "catalog:",
    "husky": "catalog:",
    "knip": "catalog:",
    "lint-staged": "catalog:",
    "ovsx": "catalog:",
    "sharp": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "lint-staged": {
    "*.{js,mjs}": [
      "eslint --fix --no-warn-ignored --max-warnings=0"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
