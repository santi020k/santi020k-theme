{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "CI",
    "OVSX_PAT",
    "STARSHIP_BIN",
    "VSCE_PAT",
    "VITEST",
    "REQUIRE_NATIVE_NEOVIM"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        "themes/**"
      ],
      "outputLogs": "errors-only"
    },
    "@santi020k/theme#build": {
      "outputs": [],
      "outputLogs": "errors-only",
      "dependsOn": ["^build"]
    },
    "@santi020k/theme-core#build": {
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "santi020k-chrome-theme#build": {
      "outputs": [],
      "outputLogs": "errors-only",
      "dependsOn": ["^build"]
    },
    "santi020k-terminal-theme#build": {
      "outputs": [
        "alacritty/**",
        "assets/previews/**",
        "ghostty/**",
        "iterm2/**",
        "kitty/**",
        "starship/**",
        "wezterm/**",
        "windows-terminal/**"
      ],
      "outputLogs": "errors-only",
      "dependsOn": [
        "^build",
        "santi020k-theme#build"
      ]
    },
    "santi020k-zed-theme#build": {
      "outputs": ["themes/santi020k.json"],
      "outputLogs": "errors-only",
      "dependsOn": [
        "^build",
        "santi020k-theme#build"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "cache": false,
      "persistent": true
    },
    "package": {
      "dependsOn": ["build"],
      "outputs": ["*.vsix"],
      "outputLogs": "errors-only"
    },
    "validate:themes": {
      "dependsOn": ["build"],
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "//#lint:knip": {
      "dependsOn": ["build"],
      "outputLogs": "errors-only"
    },
    "@santi020k/santi020k-theme-website#build": {
      "dependsOn": [
        "^build",
        "santi020k-terminal-theme#build",
        "santi020k-obsidian-theme#build",
        "santi020k-neovim-theme#build",
        "santi020k-chrome-theme#build",
        "santi020k-codex-theme#build",
        "santi020k-zed-theme#build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/*-website/src/**",
        "$TURBO_ROOT$/apps/*-website/public/**",
        "$TURBO_ROOT$/scripts/sync-consolidated-site-assets.mjs",
        "$TURBO_ROOT$/scripts/generate-wallpaper-downloads.mjs",
        "$TURBO_ROOT$/scripts/generate-banner-downloads.mjs",
        "$TURBO_ROOT$/artwork/**",
        "$TURBO_ROOT$/packages/santi020k-codex-theme/themes/**",
        "$TURBO_ROOT$/packages/santi020k-terminal-theme/prompt-presets.mjs",
        "$TURBO_ROOT$/packages/santi020k-terminal-theme/zsh/**",
        "$TURBO_ROOT$/scripts/build-theme-downloads.mjs",
        "$TURBO_ROOT$/scripts/lib/port-palette.mjs",
        "$TURBO_ROOT$/scripts/lib/color-contrast.mjs",
        "$TURBO_ROOT$/packages/santi020k-obsidian-theme/**",
        "$TURBO_ROOT$/packages/santi020k-neovim-theme/**",
        "$TURBO_ROOT$/docs/iphone-setup.md",
        "$TURBO_ROOT$/LICENSE",
        "$TURBO_ROOT$/apps/website/src/**",
        "$TURBO_ROOT$/packages/santi020k-chrome-theme/manifest*.json",
        "$TURBO_ROOT$/packages/santi020k-zed-theme/themes/**"
      ],
      "outputs": ["dist/**"],
      "outputLogs": "errors-only"
    },
    "@santi020k/santi020k-vscode-theme-website#build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/website/src/**",
        "$TURBO_ROOT$/packages/santi020k-chrome-theme/manifest*.json",
        "$TURBO_ROOT$/packages/santi020k-zed-theme/themes/**",
        "$TURBO_ROOT$/packages/santi020k-codex-theme/themes/**"
      ],
      "outputs": ["dist/**"],
      "outputLogs": "errors-only",
      "dependsOn": [
        "^build",
        "santi020k-chrome-theme#build",
        "santi020k-codex-theme#build",
        "santi020k-zed-theme#build"
      ]
    },
    "@santi020k/santi020k-chrome-theme-website#build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/website/src/**",
        "$TURBO_ROOT$/packages/santi020k-chrome-theme/manifest*.json",
        "$TURBO_ROOT$/packages/santi020k-zed-theme/themes/**",
        "$TURBO_ROOT$/packages/santi020k-codex-theme/themes/**"
      ],
      "outputs": ["dist/**"],
      "outputLogs": "errors-only",
      "dependsOn": [
        "^build",
        "santi020k-chrome-theme#build",
        "santi020k-codex-theme#build",
        "santi020k-zed-theme#build"
      ]
    },
    "@santi020k/santi020k-terminal-theme-website#build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/website/src/**"
      ],
      "outputs": ["dist/**"],
      "outputLogs": "errors-only",
      "dependsOn": ["^build"]
    },
    "@santi020k/santi020k-zed-theme-website#build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/website/src/**",
        "$TURBO_ROOT$/packages/santi020k-chrome-theme/manifest*.json",
        "$TURBO_ROOT$/packages/santi020k-zed-theme/themes/**",
        "$TURBO_ROOT$/packages/santi020k-codex-theme/themes/**"
      ],
      "outputs": ["dist/**"],
      "outputLogs": "errors-only",
      "dependsOn": [
        "^build",
        "santi020k-chrome-theme#build",
        "santi020k-codex-theme#build",
        "santi020k-zed-theme#build"
      ]
    },
    "@santi020k/santi020k-codex-theme-website#build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/santi020k-codex-theme/themes/**",
        "$TURBO_ROOT$/apps/website/src/**",
        "$TURBO_ROOT$/packages/santi020k-chrome-theme/manifest*.json",
        "$TURBO_ROOT$/packages/santi020k-zed-theme/themes/**"
      ],
      "outputs": ["dist/**"],
      "outputLogs": "errors-only",
      "dependsOn": [
        "^build",
        "santi020k-chrome-theme#build",
        "santi020k-codex-theme#build",
        "santi020k-zed-theme#build"
      ]
    },
    "santi020k-obsidian-theme#build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/lib/port-palette.mjs",
        "$TURBO_ROOT$/scripts/lib/color-contrast.mjs",
        "$TURBO_ROOT$/packages/santi020k-theme/src/tokens/vscode/base-themes/**"
      ],
      "outputs": [
        "theme.css",
        "manifest.json",
        "versions.json"
      ],
      "outputLogs": "errors-only"
    },
    "santi020k-neovim-theme#build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/lib/port-palette.mjs",
        "$TURBO_ROOT$/scripts/lib/color-contrast.mjs",
        "$TURBO_ROOT$/packages/santi020k-theme/src/tokens/vscode/base-themes/**"
      ],
      "outputs": [
        "colors/**"
      ],
      "outputLogs": "errors-only"
    }
  },
  "futureFlags": {
    "errorsOnlyShowHash": true
  }
}
