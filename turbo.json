{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "CI",
    "OVSX_PAT",
    "STARSHIP_BIN",
    "VSCE_PAT",
    "VITEST"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        "themes/**",
        "themes/*-bold-color-theme.json",
        "themes/*-italic-color-theme.json",
        "themes/santi020k-hc-light-color-theme.json",
        "themes/santi020k.json"
      ],
      "outputLogs": "errors-only"
    },
    "@santi020k/theme#build": {
      "outputs": [],
      "outputLogs": "errors-only",
      "dependsOn": ["^build"]
    },
    "@santi020k/theme-core#build": {
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "santi020k-chrome-theme#build": {
      "outputs": [],
      "outputLogs": "errors-only",
      "dependsOn": ["^build"]
    },
    "santi020k-terminal-theme#build": {
      "outputs": [
        "alacritty/**",
        "assets/previews/**",
        "ghostty/**",
        "iterm2/**",
        "kitty/**",
        "starship/**",
        "wezterm/**",
        "windows-terminal/**"
      ],
      "outputLogs": "errors-only",
      "dependsOn": [
        "^build",
        "santi020k-theme#build"
      ]
    },
    "santi020k-zed-theme#build": {
      "outputs": ["themes/santi020k.json"],
      "outputLogs": "errors-only",
      "dependsOn": [
        "^build",
        "santi020k-theme#build"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "cache": false,
      "persistent": true
    },
    "package": {
      "dependsOn": ["build"],
      "outputs": ["*.vsix"],
      "outputLogs": "errors-only"
    },
    "validate:themes": {
      "dependsOn": ["build"],
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "//#lint:knip": {
      "dependsOn": ["build"],
      "outputLogs": "errors-only"
    },
    "@santi020k/santi020k-theme-website#build": {
      "dependsOn": [
        "^build",
        "santi020k-terminal-theme#build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/*-website/src/**",
        "$TURBO_ROOT$/apps/*-website/public/**",
        "$TURBO_ROOT$/scripts/sync-consolidated-site-assets.mjs",
        "$TURBO_ROOT$/packages/santi020k-codex-theme/themes/**",
        "$TURBO_ROOT$/packages/santi020k-terminal-theme/prompt-presets.mjs",
        "$TURBO_ROOT$/packages/santi020k-terminal-theme/zsh/**"
      ],
      "outputs": ["dist/**"],
      "outputLogs": "errors-only"
    },
    "@santi020k/santi020k-vscode-theme-website#build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/website/src/components/**",
        "$TURBO_ROOT$/apps/website/src/data/**",
        "$TURBO_ROOT$/apps/website/src/utils/**"
      ],
      "outputs": ["dist/**"],
      "outputLogs": "errors-only",
      "dependsOn": ["^build"]
    },
    "@santi020k/santi020k-chrome-theme-website#build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/website/src/components/**",
        "$TURBO_ROOT$/apps/website/src/data/**",
        "$TURBO_ROOT$/apps/website/src/utils/**"
      ],
      "outputs": ["dist/**"],
      "outputLogs": "errors-only",
      "dependsOn": ["^build"]
    },
    "@santi020k/santi020k-terminal-theme-website#build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/website/src/components/**",
        "$TURBO_ROOT$/apps/website/src/data/**",
        "$TURBO_ROOT$/apps/website/src/utils/**"
      ],
      "outputs": ["dist/**"],
      "outputLogs": "errors-only",
      "dependsOn": ["^build"]
    },
    "@santi020k/santi020k-zed-theme-website#build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/website/src/components/**",
        "$TURBO_ROOT$/apps/website/src/data/**",
        "$TURBO_ROOT$/apps/website/src/utils/**"
      ],
      "outputs": ["dist/**"],
      "outputLogs": "errors-only",
      "dependsOn": ["^build"]
    },
    "@santi020k/santi020k-codex-theme-website#build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/santi020k-codex-theme/themes/**",
        "$TURBO_ROOT$/apps/website/src/components/**",
        "$TURBO_ROOT$/apps/website/src/data/**",
        "$TURBO_ROOT$/apps/website/src/utils/**"
      ],
      "outputs": ["dist/**"],
      "outputLogs": "errors-only",
      "dependsOn": ["^build"]
    }
  },
  "futureFlags": {
    "errorsOnlyShowHash": true
  }
}
