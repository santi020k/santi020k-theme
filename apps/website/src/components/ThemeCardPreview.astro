---
import { Image } from 'astro:assets'

import darkTheme from '@santi020k/theme/shiki/santi020k-dark.json'
import lightTheme from '@santi020k/theme/shiki/santi020k-light.json'

import obsidianDark from '../../../../packages/santi020k-obsidian-theme/assets/previews/preview-dark.png'
import obsidianLight from '../../../../packages/santi020k-obsidian-theme/assets/previews/preview-light.png'
import chromeDark from '../../../../packages/theme/assets/chrome/store/screenshot-main.png'
import chromeLight from '../../../../packages/theme/assets/chrome/store/screenshot-main-light.png'
import vscodeDark from '../../../../packages/theme/assets/vscode/previews/preview-dark.png'
import vscodeLight from '../../../../packages/theme/assets/vscode/previews/preview-light.png'
import phoneDark from '../../../../packages/theme/assets/wallpapers/minimal-v2/halo-dark-mobile.webp'
import phoneLight from '../../../../packages/theme/assets/wallpapers/minimal-v2/halo-light-mobile.webp'

interface Props {
  slug: string
  name: string
  featured?: boolean
}

const { slug, name, featured = false } = Astro.props
const screenshots = slug === 'vscode' ? [vscodeDark, vscodeLight] : undefined
let previewImages = screenshots

if (slug === 'chrome') {
  previewImages = [chromeDark, chromeLight]
}

if (slug === 'obsidian') previewImages = [obsidianDark, obsidianLight]

if (slug === 'iphone') previewImages = [phoneDark, phoneLight]

const palettes = [['dark', darkTheme], ['light', lightTheme]] as const

const paletteStyle = palettes.flatMap(([variant, theme]) => [
  `--preview-${variant}-bg:${theme.colors['editor.background']}`,
  `--preview-${variant}-surface:${theme.colors['sideBar.background']}`,
  `--preview-${variant}-ink:${theme.colors['editor.foreground']}`,
  `--preview-${variant}-accent:${theme.colors['textLink.foreground']}`,
  `--preview-${variant}-line:${theme.colors['panel.border']}`,
  `--preview-${variant}-selection:${theme.colors['editor.selectionBackground']}`,
  `--preview-${variant}-success:${theme.colors['terminal.ansiGreen']}`
]).join(';')

const editorSamples: Record<string, { filename: string, declaration: string, body: string }> = {
  neovim: { filename: 'init.lua', declaration: 'local workspace = {', body: '  theme = "santi020k",\n  mode = "focus"\n}' },
  zed: { filename: 'theme.ts', declaration: 'const workspace = {', body: '  theme: "santi020k",\n  mode: "focus",\n  accent: "violet"\n}' },
  jetbrains: { filename: 'Workspace.kt', declaration: 'data class Workspace(', body: '  val theme: String = "santi020k",\n  val mode: String = "focus"\n)' },
  xcode: { filename: 'Workspace.swift', declaration: 'struct Workspace {', body: '  let theme = "santi020k"\n  let mode = "focus"\n}' }
}

const sample = editorSamples[slug] ?? { filename: 'theme.ts', declaration: 'const workspace = {', body: '  theme: "santi020k"\n}' }
const statusCaption = slug === 'xcode' ? 'Editor color theme' : 'Santi020k Theme'
const captions: Record<string, string> = { iphone: 'Phone wallpaper artwork', vscode: 'Theme screenshot', obsidian: 'Obsidian screenshot' }
const previewCaption = captions[slug] ?? 'Illustrative preview'
---
<div class:list={['family-preview', `family-preview-${slug}`]} style={paletteStyle}>
  <div class="family-preview-stage" aria-hidden="true">
    {previewImages && (
      <div class="family-capture">
        <Image class="capture-dark" src={previewImages[0]} alt="" widths={[480, 800, 1200]} sizes={featured ? '(max-width: 767px) 92vw, 55vw' : '(max-width: 767px) 92vw, 360px'} loading="lazy" />
        <Image class="capture-light" src={previewImages[1]} alt="" widths={[480, 800, 1200]} sizes={featured ? '(max-width: 767px) 92vw, 55vw' : '(max-width: 767px) 92vw, 360px'} loading="lazy" />
      </div>
    )}
    {!previewImages && (
      <div class:list={['family-window', `family-window-${slug}`]}>
        <div class="family-title-bar"><span class="family-dots"><i></i><i></i><i></i></span><span>{name}</span><span>◦</span></div>
        {slug === 'terminal' && (
          <div class="family-terminal">
            <div class="family-prompt"><b>~/Projects/theme</b><span>git main</span></div>
            <p>❯ pnpm run build</p>
            <p class="family-muted">Building your workspace…</p>
            <p class="family-success">✓ Ready in 128ms</p>
            <p>❯ <span class="family-cursor"></span></p>
          </div>
        )}
        {slug === 'codex' && (
          <div class="family-agent">
            <span class="family-muted">THEME / NEW TASK</span>
            <strong>A calmer workspace</strong>
            <p>Apply the shared violet palette.</p>
            <div class="family-diff"><span>theme.css</span><code>+ background: var(--surface);<br />+ color: var(--ink);</code></div>
            <div class="family-compose">Ask a follow-up <span>↑</span></div>
          </div>
        )}
        {slug === 'raycast' && (
          <div class="family-launcher">
            <div class="family-search">⌕ <span>Find your next focus</span><small>⌘ K</small></div>
            <p class="family-muted">SUGGESTIONS</p>
            <div class="family-result is-selected"><b>›_</b><span>Visual Studio Code<small>Application</small></span><small>↵</small></div>
            <div class="family-result"><b>◇</b><span>Search files<small>Command</small></span></div>
            <div class="family-result"><b>⊞</b><span>Window management<small>Command</small></span></div>
          </div>
        )}
        {slug === 'slack' && (
          <div class="family-chat">
            <aside><strong>Workspace</strong><span># general</span><b># design</b><span># engineering</span></aside>
            <div class="family-messages"><strong># design</strong><div><b class="family-avatar">S</b><p><strong>Sam <small>10:42</small></strong><br />A little more violet.<br />A little more focus.</p></div><div class="family-chat-message">Message #design <span>+</span></div></div>
          </div>
        )}
        {['zed', 'jetbrains', 'xcode', 'neovim'].includes(slug) && (
          <div class="family-editor">
            <aside><span>PROJECT</span><b>⌄ workspace</b><span>src</span><span class="family-file">{sample.filename}</span><span>README.md</span></aside>
            <div class="family-code"><div class="family-tab">{sample.filename}<span>×</span></div><div class="family-source"><code><b>{sample.declaration}</b></code><code>{sample.body}</code><code class="family-muted">{slug === 'neovim' ? '--' : '//'} Make room to create.</code></div></div>
          </div>
        )}
        {['zed', 'jetbrains', 'xcode', 'neovim'].includes(slug) && <div class="family-status">{statusCaption}<span>UTF-8</span></div>}
      </div>
    )}
  </div>
  <div class="family-preview-caption"><span>{previewCaption}</span><span>Dark / Light</span></div>
</div>

<style>
  .family-preview-iphone .family-capture { width: auto; height: 230px; aspect-ratio: 1170 / 2532; justify-self: center; }
  .family-preview { font-weight: 400; --preview-bg: var(--preview-dark-bg); --preview-surface: var(--preview-dark-surface); --preview-ink: var(--preview-dark-ink); --preview-accent: var(--preview-dark-accent); --preview-line: var(--preview-dark-line); --preview-selection: var(--preview-dark-selection); --preview-success: var(--preview-dark-success); }
  :global([data-theme="light"]) .family-preview { --preview-bg: var(--preview-light-bg); --preview-surface: var(--preview-light-surface); --preview-ink: var(--preview-light-ink); --preview-accent: var(--preview-light-accent); --preview-line: var(--preview-light-line); --preview-selection: var(--preview-light-selection); --preview-success: var(--preview-light-success); }
  .family-preview-stage { display: grid; align-items: center; width: 100%; min-width: 0; aspect-ratio: 3 / 2; min-height: 250px; }
  .family-window, .family-capture { overflow: hidden; width: 100%; border: 1px solid var(--preview-line); border-radius: 10px; background: var(--preview-bg); color: var(--preview-ink); box-shadow: 0 14px 28px -18px color-mix(in srgb, var(--site-ink) 30%, transparent); }
  .family-capture :global(img) { width: 100%; height: auto; display: block; }
  .family-capture :global(.capture-light) { display: none; }
  :global([data-theme="light"]) .family-capture :global(.capture-dark) { display: none; }
  :global([data-theme="light"]) .family-capture :global(.capture-light) { display: block; }
  .family-window { font-family: var(--santi020k-font-mono); font-size: 9px; line-height: 1.6; }
  .family-title-bar { display: flex; align-items: center; justify-content: space-between; height: 27px; padding: 0 10px; background: var(--preview-surface); border-bottom: 1px solid var(--preview-line); }
  .family-dots { display: flex; gap: 4px; }
  .family-dots i { width: 5px; height: 5px; background: var(--preview-accent); opacity: .6; border-radius: 50%; }
  .family-preview-caption { display: flex; justify-content: space-between; gap: 8px; margin-top: 12px; color: var(--site-ink-soft); font-size: .6875rem; }
  .family-window p { margin: 0; font-size: inherit; line-height: inherit; }
  .family-muted { opacity: .72; }
  .family-success, .family-code em { color: var(--preview-success); font-style: normal; }
  .family-terminal { padding: 20px 16px; line-height: 2; }
  .family-prompt { display: flex; margin-bottom: 8px; gap: 10px; color: var(--preview-accent); }
  .family-prompt b { background: var(--preview-selection); padding: 0 5px; }
  .family-cursor { display: inline-block; width: 5px; height: 11px; vertical-align: middle; background: var(--preview-accent); }
  .family-agent { padding: 14px; }
  .family-agent > strong { display: block; font-size: 13px; margin: 5px 0; }
  .family-diff { margin: 10px 0; padding: 7px 9px; background: var(--preview-surface); border-left: 2px solid var(--preview-success); }
  .family-diff code { display: block; color: var(--preview-success); }
  .family-compose, .family-chat-message { padding: 7px; border: 1px solid var(--preview-line); border-radius: 6px; }
  .family-compose span, .family-chat-message span { float: right; color: var(--preview-accent); }
  .family-window-raycast { width: 88%; margin: auto; }
  .family-launcher { padding: 10px; }
  .family-search { display: flex; gap: 8px; align-items: center; padding: 4px 0 10px; border-bottom: 1px solid var(--preview-line); font-size: 11px; }
  .family-search small { margin-left: auto; font-size: 8px; }
  .family-launcher > p { margin: 7px 0; font-size: 7px; }
  .family-result { display: flex; align-items: center; gap: 8px; padding: 5px; border-radius: 5px; }
  .family-result > b { display: grid; place-items: center; width: 22px; height: 22px; background: var(--preview-surface); color: var(--preview-accent); border-radius: 5px; font-size: 13px; }
  .family-result small { display: block; font-size: 7px; opacity: .75; }
  .family-result > small { margin-left: auto; }
  .is-selected, .family-file { background: var(--preview-selection); }
  .family-chat, .family-editor { display: grid; grid-template-columns: 30% 1fr; }
  aside { display: flex; flex-direction: column; gap: 6px; padding: 12px 7px; background: var(--preview-surface); border-right: 1px solid var(--preview-line); font-size: 8px; overflow: hidden; }
  aside b { font-weight: 500; }
  .family-chat aside b { padding: 3px; background: var(--preview-selection); }
  .family-messages { padding: 10px; }
  .family-messages > div:not(.family-chat-message) { display: flex; gap: 6px; margin: 18px 0; }
  .family-avatar { display: grid; place-items: center; flex-shrink: 0; width: 23px; height: 23px; background: var(--preview-selection); border-radius: 5px; }
  .family-messages small { font-size: 7px; font-weight: 400; }
  .family-code { min-width: 0; }
  .family-tab { display: flex; justify-content: space-between; padding: 5px 10px; background: var(--preview-surface); border-bottom: 1px solid var(--preview-line); }
  .family-source { margin: 0; padding: 12px 8px; font: inherit; font-size: 8px; line-height: 1.9; white-space: pre; }
  .family-source code { display: block; font: inherit; white-space: pre; }
  .family-source code:last-child { margin-top: 12px; }
  .family-code b { color: var(--preview-accent); font-weight: 500; }
  .family-status { display: flex; justify-content: space-between; padding: 3px 10px; background: var(--preview-surface); border-top: 1px solid var(--preview-line); font-size: 7px; }
</style>
