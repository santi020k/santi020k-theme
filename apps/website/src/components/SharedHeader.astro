---
import { Button, Icon, Link, ThemeToggle } from '@santi020k/lumen-astro'

import { products } from '../data/products.js'

interface NavigationItem {
  href: string
  label: string
}

interface Props {
  currentProduct?: string
  productLinks?: NavigationItem[]
}

const { currentProduct, productLinks = [] } = Astro.props
const pathname = Astro.url.pathname
const product = products.find(item => item.slug === currentProduct)
let contextualLinks = productLinks

if (contextualLinks.length === 0 && product) {
  contextualLinks = [{ href: `/${product.slug}/`, label: 'Overview' }]
}

const isActive = (href: string) => {
  if (href.includes('#')) return false

  return pathname === href
}
---

<div class="family-header-stack">
  <header class="family-header site-shell" aria-label="Site header">
    <span class="family-header-signature" aria-hidden="true">One violet. Every surface.</span>
    <Link class="family-brand" href="/" aria-label="Santi020k Themes home">
      <svg class="family-brand-mark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 80 80" aria-hidden="true" focusable="false"><rect width="80" height="80" rx="18" fill="currentColor" /><path d="M26 28 L40 40 L26 52" fill="none" stroke="var(--site-brand-mark-ink)" stroke-width="8" stroke-linecap="round" stroke-linejoin="round" /><line x1="48" y1="52" x2="62" y2="52" stroke="var(--site-brand-mark-ink)" stroke-width="8" stroke-linecap="round" /></svg>
      <span>Santi020k <b>Themes</b></span>
    </Link>

    <nav id="family-primary-navigation" class="family-primary-navigation" aria-label="Primary navigation">
      <div class="family-menu-heading" aria-hidden="true"><span>Explore the family</span><small>One palette, your whole workspace.</small></div>
      <Link href="/" aria-current={pathname === '/' ? 'page' : undefined}>Home</Link>
      <details class:list={['family-theme-menu', { 'has-current-product': product }]}>
        <summary aria-label={product ? `Change theme. Current theme: ${product.name}` : 'Choose a theme'}>
          <span class="family-theme-selector-copy">
            <small>Theme</small>
            <strong>{product?.name ?? 'All themes'}</strong>
          </span>
          <Icon name="chevron-down" />
        </summary>
        <div class="family-theme-panel">
          <div class="family-theme-panel-heading">
            <div><strong>Choose a surface</strong><small>Carry the same palette into your next tool.</small></div>
            <span>{products.length} themes</span>
          </div>
          <div class="family-theme-panel-grid">
            {products.map(item => (
              <Link href={`/${item.slug}/`} aria-current={item.slug === currentProduct ? 'page' : undefined}>
                <span class="family-theme-item-heading">
                  <strong>{item.name}</strong>
                  <i>{item.slug === currentProduct ? 'Current' : 'View'}</i>
                </span>
                <small>{item.summary}</small>
              </Link>
            ))}
          </div>
        </div>
      </details>
      <Link href="/gallery/" aria-current={pathname === '/gallery/' ? 'page' : undefined}>Gallery</Link>
      <Link href="/design/" aria-current={pathname === '/design/' ? 'page' : undefined}>Design</Link>
      <Link href="/terminal/docs/" aria-current={pathname.startsWith('/terminal/docs/') ? 'page' : undefined}>Docs</Link>
      <Link href="/support/" aria-current={pathname === '/support/' ? 'page' : undefined}>Support</Link>
    </nav>

    <div class="family-header-actions">
      <Button class="family-nav-toggle" variant="ghost" size="icon" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="family-primary-navigation"><span class="family-nav-label">Menu</span><span class="family-nav-open-icon"><Icon name="menu" /></span><span class="family-nav-close-icon" hidden><Icon name="x" /></span></Button>
      <ThemeToggle class="family-theme-toggle theme-toggle" aria-label="Toggle color theme" storageKey="theme" />
    </div>
  </header>

  {product && (
    <div class="family-context-navigation-wrap">
      <div class="family-context-navigation site-shell">
        <Link class="family-product-name" href={`/${product.slug}/`}>
          <span>Theme for</span>
          <strong>{product.name}</strong>
        </Link>
        <nav aria-label={`${product.name} navigation`}>
          {contextualLinks.map(item => <Link href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</Link>)}
        </nav>
      </div>
    </div>
  )}
</div>

<script>
import { bindPageLifecycle } from '../utils/page-lifecycle'

bindPageLifecycle('*', signal => {
  const navigation = document.querySelector<HTMLElement>('#family-primary-navigation')
  const toggle = document.querySelector<HTMLButtonElement>('.family-nav-toggle')
  const themeMenu = document.querySelector<HTMLDetailsElement>('.family-theme-menu')
  const desktopBreakpoint = window.matchMedia('(min-width: 1101px)')
  const header = document.querySelector<HTMLElement>('.family-header')
  const label = toggle?.querySelector('.family-nav-label')
  const openIcon = toggle?.querySelector<HTMLElement>('.family-nav-open-icon')
  const closeIcon = toggle?.querySelector<HTMLElement>('.family-nav-close-icon')

  const syncToggle = (isOpen: boolean) => {
    if (label) label.textContent = isOpen ? 'Close' : 'Menu'

    if (openIcon) openIcon.hidden = isOpen

    if (closeIcon) closeIcon.hidden = !isOpen
  }

  const setNavigation = (isOpen: boolean) => {
    navigation?.classList.toggle('is-open', isOpen)

    header?.classList.toggle('has-open-menu', isOpen)

    toggle?.setAttribute('aria-expanded', String(isOpen))

    toggle?.setAttribute('aria-label', isOpen ? 'Close navigation' : 'Open navigation')

    syncToggle(isOpen)

    if (!isOpen && themeMenu) themeMenu.open = false
  }

  const closeNavigation = () => setNavigation(false)

  toggle?.addEventListener('click', () => {
    setNavigation(toggle.getAttribute('aria-expanded') !== 'true')
  }, { signal })

  navigation?.addEventListener('click', event => {
    if (event.target instanceof Element && event.target.closest('a')) closeNavigation()
  }, { signal })

  desktopBreakpoint.addEventListener('change', () => {
    const focusWasInNavigation = navigation?.contains(document.activeElement)

    closeNavigation()

    if (!desktopBreakpoint.matches && focusWasInNavigation) toggle?.focus()
  }, { signal })

  document.addEventListener('click', event => {
    if (!(event.target instanceof Node)) return

    if (navigation?.classList.contains('is-open') && !header?.contains(event.target)) closeNavigation()

    if (themeMenu?.open && !themeMenu.contains(event.target)) themeMenu.open = false
  }, { signal })

  document.addEventListener('focusin', event => {
    if (event.target instanceof Node && !header?.contains(event.target)) closeNavigation()
  }, { signal })

  document.addEventListener('keydown', event => {
    if (event.key !== 'Escape') return

    if (navigation?.classList.contains('is-open')) {
      closeNavigation()

      toggle?.focus()
    } else if (themeMenu?.open) {
      themeMenu.open = false

      themeMenu.querySelector('summary')?.focus()
    }
  }, { signal })

return undefined
})
</script>

<style>
  :global(html) {
    scroll-padding-top: 148px;
  }
  .family-header-signature,
  .family-menu-heading {
    display: none;
  }
  .family-header :is(a, button):focus-visible {
    outline: 2px solid var(--site-brand);
    outline-offset: 3px;
  }
  .family-header-stack {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--site-line);
    background: var(--theme-bg);
  }
  .family-header {
    display: grid;
    width: var(--site-shell-width);
    min-height: 88px;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 24px;
    align-items: center;
    margin-inline: auto;
  }
  .family-brand {
    display: inline-flex;
    gap: 11px;
    align-items: center;
    min-width: max-content;
    font-weight: 500;
    text-decoration: none;
  }
  .family-brand b {
    color: var(--site-brand);
  }
  .family-brand-mark {
    width: 34px;
    height: 34px;
    flex: 0 0 34px;
    border-radius: 8px;
    color: var(--site-brand-solid);

  }
  .family-primary-navigation {
    display: flex;
    gap: clamp(6px, 1vw, 12px);
    align-items: center;
    justify-content: flex-end;
    color: var(--site-ink-soft);
    font-size: .88rem;
    font-weight: 500;
  }
  .family-primary-navigation > a,
  .family-theme-menu > summary {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    border-radius: 1rem;
    color: inherit;
    text-decoration: none;
    cursor: pointer;
  }
  .family-primary-navigation > a {
    padding-inline: 11px;
  }
  .family-primary-navigation > a:hover,
  .family-primary-navigation > a[aria-current='page'] {
    background: color-mix(in srgb, var(--site-brand) 10%, transparent);
    color: var(--site-brand);
  }
  .family-theme-menu > summary:hover,
  .family-theme-menu[open] > summary {
    border-color: color-mix(in srgb, var(--site-brand) 62%, var(--site-line));
    background: color-mix(in srgb, var(--site-brand) 9%, var(--btn-secondary-bg));
    color: var(--site-brand);
  }
  .family-theme-menu {
    position: relative;
  }
  .family-theme-menu > summary {
    min-width: 132px;
    gap: 12px;
    justify-content: space-between;
    padding: 5px 10px 5px 12px;
    border: 1px solid var(--site-line);
    background: var(--btn-secondary-bg);
    list-style: none;
  }
  .family-theme-selector-copy {
    display: grid;
    gap: 1px;
  }
  .family-theme-selector-copy small {
    color: var(--site-ink-soft);
    font-size: .54rem;
    font-weight: 600;
    letter-spacing: .09em;
    line-height: 1;
    text-transform: uppercase;
  }
  .family-theme-selector-copy strong {
    color: var(--site-ink);
    font-size: .76rem;
    line-height: 1.2;
  }
  .family-theme-menu[open] .family-theme-selector-copy strong,
  .family-theme-menu.has-current-product .family-theme-selector-copy strong {
    color: var(--site-brand);
  }
  .family-theme-menu > summary::-webkit-details-marker {
    display: none;
  }
  .family-theme-menu > summary:focus-visible {
    outline: 3px solid var(--site-brand);
    outline-offset: 3px;
  }
  .family-theme-menu > summary :global(svg) {
    width: 15px;
    transition: transform .2s ease;
  }
  .family-theme-menu[open] > summary :global(svg) {
    transform: rotate(180deg);
  }
  .family-theme-panel {
    position: absolute;
    top: calc(100% + 10px);
    right: -176px;
    display: grid;
    width: min(680px, calc(100vw - var(--site-shell-gutter) - var(--site-shell-gutter)));
    gap: 12px;
    padding: 14px;
    border: 1px solid var(--site-line);
    border-radius: 16px;
    background: var(--site-surface);
    box-shadow: 0 24px 70px color-mix(in srgb, #000 34%, transparent);
  }
  .family-theme-panel-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 4px 6px 12px;
    border-bottom: 1px solid var(--section-divider);
  }
  .family-theme-panel-heading > div {
    display: grid;
    gap: 4px;
  }
  .family-theme-panel-heading strong {
    color: var(--site-ink);
    font-size: .82rem;
  }
  .family-theme-panel-heading small {
    color: var(--site-ink-soft);
    font-size: .68rem;
  }
  .family-theme-panel-heading > span {
    flex: 0 0 auto;
    padding: 5px 8px;
    border: 1px solid var(--site-line);
    border-radius: 999px;
    color: var(--site-ink-soft);
    font-size: .62rem;
    font-weight: 500;
    text-transform: uppercase;
  }
  .family-theme-panel-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 6px;
  }
  .family-theme-panel-grid a {
    display: grid;
    gap: 5px;
    padding: 13px;
    border: 1px solid transparent;
    border-radius: 1rem;
    text-decoration: none;
  }
  .family-theme-panel-grid a:hover,
  .family-theme-panel-grid a[aria-current='page'] {
    border-color: color-mix(in srgb, var(--site-brand) 28%, var(--site-line));
    background: color-mix(in srgb, var(--site-brand) 12%, transparent);
  }
  .family-theme-item-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .family-theme-item-heading strong {
    color: var(--site-ink);
    font-size: .78rem;
  }
  .family-theme-item-heading i {
    color: var(--site-ink-soft);
    font-size: .58rem;
    font-style: normal;
    font-weight: 500;
    letter-spacing: .04em;
    text-transform: uppercase;
  }
  .family-theme-panel-grid a[aria-current='page'] .family-theme-item-heading strong,
  .family-theme-panel-grid a[aria-current='page'] .family-theme-item-heading i {
    color: var(--site-brand);
  }
  .family-theme-panel-grid a > small {
    display: -webkit-box;
    overflow: hidden;
    color: var(--site-ink-soft);
    font-size: .72rem;
    line-height: 1.45;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .family-header-actions {
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .family-nav-toggle,
  .family-theme-toggle {
    width: 44px;
    height: 44px;
    border: 1px solid var(--site-line);
    border-radius: 1rem;
    background: var(--site-surface);
    color: var(--site-ink);
  }
  .family-nav-toggle {
    display: none;
  }
  .family-context-navigation-wrap {
    border-top: 1px solid var(--section-divider);
    background: var(--site-surface);
  }
  .family-context-navigation {
    display: flex;
    width: var(--site-shell-width);
    min-height: 50px;
    gap: 28px;
    align-items: center;
    margin-inline: auto;
  }
  .family-product-name {
    display: inline-flex;
    flex: 0 0 auto;
    gap: 7px;
    align-items: baseline;
    text-decoration: none;
  }
  .family-product-name span {
    color: var(--site-ink-soft);
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .06em;
    text-transform: uppercase;
  }
  .family-product-name strong {
    color: var(--site-ink);
    font-size: .9rem;
  }
  .family-context-navigation nav {
    display: flex;
    min-width: 0;
    gap: 6px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .family-context-navigation nav::-webkit-scrollbar {
    display: none;
  }
  .family-context-navigation nav a {
    flex: 0 0 auto;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    padding: 8px 11px;
    border-radius: 0.75rem;
    color: var(--site-ink-soft);
    font-size: .78rem;
    font-weight: 500;
    text-decoration: none;
  }
  .family-context-navigation nav a:hover,
  .family-context-navigation nav a[aria-current='page'] {
    background: color-mix(in srgb, var(--site-brand) 10%, transparent);
    color: var(--site-brand);
  }
  @media (max-width: 1100px) {
    .family-header-stack {
      padding-top: 28px;
      border-bottom: 0;
    }
    .family-header {
      position: relative;
      min-height: 68px;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 12px;
      padding: 10px 12px;
      border: 1px solid var(--site-line);
      border-radius: 0 18px 18px 18px;
      background: var(--site-surface);
    }
    .family-header.has-open-menu {
      border-bottom-color: transparent;
      border-radius: 0 18px 0 0;
    }
    .family-header-signature {
      position: absolute;
      top: -20px;
      left: -1px;
      display: block;
      padding: 4px 18px 4px 12px;
      border: 1px solid var(--site-line);
      border-bottom: 0;
      border-radius: 10px 12px 0 0;
      background: var(--site-surface);
      color: var(--site-ink-soft);
      font-size: .56rem;
      font-weight: 600;
      letter-spacing: .1em;
      line-height: 12px;
      text-transform: uppercase;
    }
    .family-brand {
      min-width: 0;
      gap: 8px;
    }
    .family-primary-navigation {
      position: absolute;
      top: 100%;
      right: -1px;
      left: -1px;
      display: none;
      align-items: stretch;
      justify-content: flex-start;
      flex-direction: column;
      gap: 0;
      max-height: calc(100dvh - 110px);
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: 12px 20px 20px;
      border: 1px solid var(--site-line);
      border-top: 0;
      border-radius: 0 0 18px 18px;
      background: var(--site-surface);
      box-shadow: 0 24px 40px color-mix(in srgb, var(--site-ink) 12%, transparent);
      counter-reset: navigation;
    }
    .family-primary-navigation.is-open {
      display: flex;
    }
    .family-primary-navigation > * {
      flex-shrink: 0;
    }
    .family-primary-navigation > a[aria-current='page'],
    .family-theme-menu[open] .family-theme-selector-copy strong,
    .family-theme-menu.has-current-product .family-theme-selector-copy strong {
      color: var(--site-ink);
    }
    .family-menu-heading {
      display: grid;
      gap: 6px;
      padding: 8px 0 20px;
      border-bottom: 1px solid var(--section-divider);
    }
    .family-menu-heading span {
      color: var(--site-ink);
      font-size: .65rem;
      font-weight: 600;
      letter-spacing: .12em;
      text-transform: uppercase;
    }
    .family-menu-heading small {
      color: var(--site-ink-soft);
      font-size: .75rem;
    }
    .family-primary-navigation > a,
    .family-theme-menu > summary {
      min-height: 62px;
      gap: 14px;
      padding: 12px 6px;
      border: 0;
      border-bottom: 1px solid var(--section-divider);
      border-radius: 0;
      background: transparent;
      color: var(--site-ink);
      font-size: clamp(1.35rem, 4vw, 1.75rem);
      font-weight: 500;
      letter-spacing: -.04em;
      counter-increment: navigation;
    }
    .family-primary-navigation > a::before,
    .family-theme-menu > summary::before {
      content: counter(navigation, decimal-leading-zero);
      color: var(--site-ink-soft);
      font-size: .65rem;
      letter-spacing: 0;
    }
    .family-primary-navigation > a::after {
      margin-left: auto;
      content: '↗';
      color: var(--site-ink-soft);
      font-size: 1.1rem;
    }
    .family-theme-menu > summary {
      width: 100%;
      justify-content: flex-start;
    }
    .family-theme-menu > summary :global(svg) {
      width: 20px;
    }
    .family-theme-menu > summary > :last-child {
      margin-left: auto;
    }
    .family-theme-selector-copy small {
      display: none;
    }
    .family-theme-selector-copy strong {
      font-size: inherit;
      font-weight: inherit;
    }
    .family-theme-panel {
      position: static;
      width: 100%;
      margin: 0;
      padding: 16px 0;
      border: 0;
      border-bottom: 1px solid var(--section-divider);
      border-radius: 0;
      background: transparent;
      box-shadow: none;
    }
    .family-theme-panel-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .family-theme-panel-grid a {
      min-height: 48px;
      padding: 12px 8px;
      border-radius: 8px;
    }
    .family-nav-toggle {
      display: inline-flex;
      width: auto;
      min-width: 82px;
      padding-inline: 10px;
      border-radius: 10px;
      font-size: .7rem;
    }
    .family-nav-toggle :global(.ui-button__content) {
      gap: 8px;
    }
    .family-nav-toggle[aria-expanded='true'] {
      background: var(--site-ink);
      color: var(--theme-bg);
    }
    .family-header-actions {
      gap: 8px;
    }
    .family-theme-toggle {
      border-radius: 10px;
    }
    .family-context-navigation-wrap {
      margin-top: 12px;
    }
    .family-context-navigation {
      gap: 18px;
    }
  }
  @media (max-width: 600px) {
    :global(html) {
      scroll-padding-top: 134px;
    }
    .family-brand span {
      font-size: .78rem;
      line-height: 1.35;
    }
    .family-brand b {
      display: block;
      font-weight: 500;
    }
    .family-theme-panel-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .family-theme-panel-grid a > small,
    .family-theme-panel-heading small {
      display: none;
    }
    .family-context-navigation {
      align-items: stretch;
      flex-direction: column;
      gap: 0;
      padding-block: 7px;
    }
    .family-product-name {
      padding-inline: 10px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .family-theme-menu > summary :global(svg) {
      transition: none;
    }
  }
</style>
