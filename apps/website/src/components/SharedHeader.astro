---
import { Button, Dialog, Icon, Link, ThemeToggle } from '@santi020k/lumen-astro'

import { products } from '../data/products.js'

interface NavigationItem {
  href: string
  label: string
}

interface Props {
  currentProduct?: string
  productLinks?: NavigationItem[]
}

const { currentProduct, productLinks = [] } = Astro.props
const pathname = Astro.url.pathname
const product = products.find(item => item.slug === currentProduct)
let contextualLinks = productLinks

if (contextualLinks.length === 0 && product) {
  contextualLinks = [{ href: `/${product.slug}/`, label: 'Overview' }]
}

const isActive = (href: string) => {
  if (href.includes('#')) return false

  return pathname === href
}
---

<div class="family-header-stack">
  <header class="family-header site-shell" aria-label="Site header">
    <Link class="family-brand" href="/" aria-label="Santi020k Themes home">
      <svg class="family-brand-mark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 80 80" aria-hidden="true" focusable="false"><rect width="80" height="80" rx="18" fill="currentColor" /><path d="M26 28 L40 40 L26 52" fill="none" stroke="var(--site-brand-mark-ink)" stroke-width="8" stroke-linecap="round" stroke-linejoin="round" /><line x1="48" y1="52" x2="62" y2="52" stroke="var(--site-brand-mark-ink)" stroke-width="8" stroke-linecap="round" /></svg>
      <span>Santi020k <b>Themes</b></span>
    </Link>

    <nav id="family-primary-navigation" class="family-primary-navigation" aria-label="Primary navigation">
      <Link href="/" aria-current={pathname === '/' ? 'page' : undefined}>Home</Link>
      <details class:list={['family-theme-menu', { 'has-current-product': product }]}>
        <summary aria-label={product ? `Change theme. Current theme: ${product.name}` : 'Choose a theme'}>
          <span class="family-theme-selector-copy">
            <small>Theme</small>
            <strong>{product?.name ?? 'All themes'}</strong>
          </span>
          <Icon name="chevron-down" />
        </summary>
        <div class="family-theme-panel">
          <div class="family-theme-panel-heading">
            <div><strong>Choose a surface</strong><small>Carry the same palette into your next tool.</small></div>
            <span>{products.length} themes</span>
          </div>
          <div class="family-theme-panel-grid">
            {products.map(item => (
              <Link href={`/${item.slug}/`} aria-current={item.slug === currentProduct ? 'page' : undefined}>
                <span class="family-theme-item-heading">
                  <strong>{item.name}</strong>
                  <i>{item.slug === currentProduct ? 'Current' : 'View'}</i>
                </span>
                <small>{item.summary}</small>
              </Link>
            ))}
          </div>
        </div>
      </details>
      <Link href="/gallery/" aria-current={pathname === '/gallery/' ? 'page' : undefined}>Gallery</Link>
      <Link href="/design/" aria-current={pathname === '/design/' ? 'page' : undefined}>Design</Link>
      <Link href="/terminal/docs/" aria-current={pathname.startsWith('/terminal/docs/') ? 'page' : undefined}>Docs</Link>
      <Link href="/support/" aria-current={pathname === '/support/' ? 'page' : undefined}>Support</Link>
    </nav>

    <div class="family-header-actions">
      <Button class="family-nav-toggle" variant="ghost" size="icon" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="family-mobile-navigation" aria-haspopup="dialog"><span class="family-nav-label">Menu</span><span class="family-nav-open-icon"><Icon name="layout-grid" /></span></Button>
      <ThemeToggle class="family-theme-toggle theme-toggle" aria-label="Toggle color theme" storageKey="theme" />
    </div>
  </header>

  {product && (
    <div class="family-context-navigation-wrap">
      <div class="family-context-navigation site-shell">
        <Link class="family-product-name" href={`/${product.slug}/`}>
          <span>Theme for</span>
          <strong>{product.name}</strong>
        </Link>
        <nav aria-label={`${product.name} navigation`}>
          {contextualLinks.map(item => <Link href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</Link>)}
        </nav>
      </div>
    </div>
  )}
</div>

<Dialog id="family-mobile-navigation" class="family-mobile-navigation" layout="fullscreen" aria-labelledby="family-mobile-title">
  <div class="family-mobile-topbar">
    <span class="family-mobile-wordmark">Santi020k <strong>Themes</strong></span>
    <div class="family-mobile-topbar-actions">
      <ThemeToggle class="family-mobile-appearance" aria-label="Toggle color theme" storageKey="theme" />
      <Button class="family-mobile-close" variant="ghost" type="button" data-mobile-close autofocus>
        <span>Close</span><Icon name="x" />
      </Button>
    </div>
  </div>
  <div class="family-mobile-body">
    <div class="family-mobile-intro">
      <p><span class="family-mobile-status" aria-hidden="true"></span> One violet. Every surface.</p>
      <h2 id="family-mobile-title">Your workspace.<br /><span>In one palette.</span></h2>
    </div>
    <nav class="family-mobile-products" aria-label="Theme products">
      <div class="family-mobile-section-heading"><h3>Choose your surface</h3><span>{products.length} themes</span></div>
      <div class="family-mobile-product-grid">
        {products.map(item => (
          <Link href={`/${item.slug}/`} aria-current={item.slug === currentProduct ? 'page' : undefined}>
            <span class="family-mobile-product-category"><span class="family-mobile-product-number" aria-hidden="true">{String(products.indexOf(item) + 1).padStart(2, '0')}</span>{item.category}</span>
            <span class="family-mobile-product-title">{item.name}<Icon name="arrow-up-right" /></span>
            {item.slug === currentProduct && <span class="family-mobile-current">You’re here</span>}
          </Link>
        ))}
      </div>
    </nav>
    <nav class="family-mobile-explore" aria-label="Explore the website">
      <h3>More to explore</h3>
      <div>
        <Link href="/" aria-current={pathname === '/' ? 'page' : undefined}>Home</Link>
        <Link href="/gallery/" aria-current={pathname === '/gallery/' ? 'page' : undefined}>Gallery</Link>
        <Link href="/design/" aria-current={pathname === '/design/' ? 'page' : undefined}>Design</Link>
        <Link href="/terminal/docs/" aria-current={pathname.startsWith('/terminal/docs/') ? 'page' : undefined}>Docs</Link>
        <Link href="/support/" aria-current={pathname === '/support/' ? 'page' : undefined}>Support</Link>
      </div>
    </nav>
    <div class="family-mobile-footer">
      <span>Make yourself at home.</span>
    </div>
  </div>
</Dialog>

<script>
import { bindContextNavigation, bindHeaderScrollOffset } from '../utils/context-navigation'
import { createMenuMotion } from '../utils/menu-motion'
import { bindPageLifecycle } from '../utils/page-lifecycle'

const bindThemeMenu = (signal: AbortSignal) => {
  const themeMenu = document.querySelector<HTMLDetailsElement>('.family-theme-menu')
  const themePanel = themeMenu?.querySelector<HTMLElement>('.family-theme-panel')
  const themeMotion = themePanel ? createMenuMotion(themePanel, -8) : undefined
  let themeClosing = false

  const closeThemeMenu = () => {
    if (!themeMenu?.open || themeClosing) return

    themeClosing = true

    themeMotion?.play(false, () => {
      themeMenu.open = false

      themeClosing = false
    })
  }

  themeMenu?.querySelector('summary')?.addEventListener('click', event => {
    event.preventDefault()

    if (themeMenu.open && !themeClosing) closeThemeMenu()
    else {
      themeClosing = false

      themeMenu.open = true

      themeMotion?.play(true)
    }
  }, { signal })

  document.addEventListener('click', event => {
    if (themeMenu?.open && event.target instanceof Node && !themeMenu.contains(event.target)) closeThemeMenu()
  }, { signal })

  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && themeMenu?.open) {
      closeThemeMenu()

      themeMenu.querySelector('summary')?.focus()
    }
  }, { signal })

  return () => {
    themeMotion?.cancel()

    if (themeMenu) themeMenu.open = false
  }
}

bindPageLifecycle('*', signal => {
  const disposeScrollOffset = bindHeaderScrollOffset()
  const disposeContextNavigation = bindContextNavigation(signal)
  const disposeThemeMenu = bindThemeMenu(signal)
  const toggle = document.querySelector<HTMLButtonElement>('.family-nav-toggle')
  const dialog = document.querySelector<HTMLDialogElement>('#family-mobile-navigation')
  const desktopBreakpoint = window.matchMedia('(min-width: 1101px)')
  const previousOverflow = document.documentElement.style.overflow
  const mobileMotion = dialog ? createMenuMotion(dialog, 20) : undefined
  let restoreFocus = false
  let scrollPosition = { left: window.scrollX, top: window.scrollY }

  const syncClosedState = () => {
    if (dialog?.open) return

    toggle?.setAttribute('aria-expanded', 'false')

    document.documentElement.style.overflow = previousOverflow

    if (restoreFocus && toggle?.isConnected && !desktopBreakpoint.matches) {
      toggle.focus({ preventScroll: true })

      window.scrollTo({ ...scrollPosition, behavior: 'instant' })
    }
  }

  const closeNavigation = (returnFocus = true, animate = true) => {
    restoreFocus = returnFocus

    const finish = () => {
      dialog?.close()

      syncClosedState()
    }

    if (dialog?.open && animate) mobileMotion?.play(false, finish)
    else {
      mobileMotion?.cancel()

      finish()
    }
  }

  toggle?.addEventListener('click', () => {
    if (!dialog || dialog.open || desktopBreakpoint.matches) return

    restoreFocus = true

    scrollPosition = { left: window.scrollX, top: window.scrollY }

    dialog.showModal()

    mobileMotion?.play(true)

    dialog.scrollTop = 0

    const body = dialog.querySelector('.family-mobile-body')

    if (body) body.scrollTop = 0

    document.documentElement.style.overflow = 'hidden'

    window.scrollTo({ ...scrollPosition, behavior: 'instant' })

    toggle.setAttribute('aria-expanded', 'true')
  }, { signal })

  dialog?.querySelector('[data-mobile-close]')?.addEventListener('click', () => closeNavigation(), { signal })

  dialog?.addEventListener('close', () => {
    mobileMotion?.cancel()

    syncClosedState()
  }, { signal })

  dialog?.addEventListener('cancel', event => {
    event.preventDefault()

    closeNavigation()
  }, { signal })

  dialog?.addEventListener('keydown', event => {
    if (event.key !== 'Tab') return

    const controls = Array.from(dialog.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'))
      .filter(control => control.getClientRects().length > 0)

    const first = controls.at(0)
    const last = controls.at(-1)
    const destination = event.shiftKey ? last : first
    const boundary = event.shiftKey ? first : last

    if (document.activeElement === boundary && destination) {
      event.preventDefault()

      destination.focus({ preventScroll: true })
    }
  }, { signal })

  dialog?.addEventListener('click', event => {
    if (event.target instanceof Element && event.target.closest('a')) closeNavigation(false, false)
  }, { signal })

  desktopBreakpoint.addEventListener('change', () => closeNavigation(false, false), { signal })

  return () => {
    disposeScrollOffset()

    disposeContextNavigation()

    disposeThemeMenu()

    closeNavigation(false, false)
  }
})
</script>

<style>
  :global(html) {
    scroll-padding-top: var(--family-header-height, 140px);
  }
  :global(main section[id]) {
