    gap: clamp(6px, 1vw, 12px);
    align-items: center;
    justify-content: flex-end;
    color: var(--site-ink-soft);
    font-size: .88rem;
    font-weight: 500;
  }
  .family-primary-navigation > a,
  .family-theme-menu > summary {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
