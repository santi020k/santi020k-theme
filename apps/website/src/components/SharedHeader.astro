    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--site-line);
    background: var(--theme-bg);
  }
  .family-header {
    display: grid;
    width: var(--site-shell-width);
    min-height: 88px;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 24px;
    align-items: center;
    margin-inline: auto;
  }
  .family-brand {
    display: inline-flex;
    gap: 11px;
    align-items: center;
    min-width: max-content;
    font-weight: 500;
    text-decoration: none;
  }
  .family-brand b {
    color: var(--site-brand);
  }
  .family-brand-mark {
    width: 34px;
