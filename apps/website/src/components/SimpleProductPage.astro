---
import '../styles/ports.css'

import { Eyebrow, Icon } from '@santi020k/lumen-astro'

import ProductLayout from '../layouts/ProductLayout.astro'

import ProductAction from './ProductAction.astro'
import ThemeCardPreview from './ThemeCardPreview.astro'

interface Step {
  detail: string
  title: string
}

interface Props {
  availability: string
  description: string
  eyebrow: string
  features: string[]
  name: string
  packagePath: string
  primaryAction?: { href: string, label: string }
  slug: string
  steps: Step[]
  title: string
}

const {
  availability, description, eyebrow, features, name, packagePath,
  primaryAction, slug, steps, title
} = Astro.props

const sourceUrl = `https://github.com/santi020k/santi020k-theme/tree/main/packages/${packagePath}`
const mainAction = primaryAction ?? { href: '#install', label: `Install for ${name}` }
---

<ProductLayout {name} {slug} title={`Santi020k Theme — ${name}`} {description}>
  <section class="site-shell port-hero">
    <div>
      <Eyebrow class="eyebrow">{eyebrow}</Eyebrow>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <div class="port-meta" aria-label="Theme status"><span>{availability}</span><span>Dark + light</span><span>Open source</span></div>
      <div class="port-actions"><ProductAction href={mainAction.href}>{mainAction.label}</ProductAction><ProductAction href={sourceUrl} newTab variant="secondary">View package source</ProductAction></div>
    </div>
    <figure class="port-figure" aria-label={`${name} illustrative preview`}>
      <ThemeCardPreview {slug} {name} hero />
    </figure>
  </section>
  <section id="install" class="site-shell port-section">
    <div class="port-section-heading"><Eyebrow class="eyebrow">Install</Eyebrow><h2>Bring the palette into {name}.</h2></div>
    <ol class="port-steps port-steps-wide">{steps.map(step => <li><div><h3>{step.title}</h3><p>{step.detail}</p></div></li>)}</ol>
  </section>
  <section id="coverage" class="site-shell port-section port-columns">
    <div><Eyebrow class="eyebrow">Coverage</Eyebrow><h2>Familiar colors. In every detail.</h2><p class="lede">The same violet accents and considered contrast, adapted to the parts of {name} you use every day.</p></div>
    <ul class="port-features">{features.map(feature => <li><Icon name="check" /><span>{feature}</span></li>)}</ul>
  </section>
</ProductLayout>
