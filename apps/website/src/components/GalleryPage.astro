---
import { Image } from 'astro:assets'

import '../styles.css'
import '../styles/wallpapers.css'

import { BackToTop, Button, ButtonLink, Card, Dialog, Eyebrow, Icon, Link } from '@santi020k/lumen-astro'
import UIPrimitives from '@santi020k/lumen-astro/runtime'

import { wallpaperDesigns, wallpaperHref } from '../../../../artwork/wallpaper-catalog.mjs'
import PageTransitions from '../components/PageTransitions.astro'
import SharedFooter from '../components/SharedFooter.astro'
import SharedHeader from '../components/SharedHeader.astro'
import { galleryAssets } from '../data/gallery-assets.js'

interface Props { archive?: boolean }

const { archive = false } = Astro.props
const canonical = `https://theme.santi020k.com/gallery/${archive ? 'archive/' : ''}`
const title = archive ? 'Classic Wallpaper Archive — Santi020k Theme' : 'Wallpaper Gallery & Downloads — Santi020k Theme'
const description = archive ? 'Browse the original Santi020k wallpaper collection. Earlier artwork and download links remain available in the Classic archive.' : 'Explore eight violet wallpaper designs for desktop and phone. Choose light or dark artwork, PNG, JPG, WEBP, quality, and screen resolution.'

const assets = galleryAssets.filter(asset => {
  if (archive) return 'collection' in asset && asset.collection === 'classic'

  if (asset.category !== 'wallpapers') return true

  return 'collection' in asset && asset.collection !== 'classic' && asset.variant === 'Desktop' && asset.title.endsWith(' · dark')
}).map(asset => ({ ...asset, design: wallpaperDesigns.find(design => asset.title.startsWith(`${design.name} ·`)) }))

const socialImage = 'https://theme.santi020k.com/og-image.png'
const imageAlt = 'Santi020k Theme gallery with wallpapers, banners, editor previews, and brand assets'
const categories = archive ? [] : ['minimal', 'signature', 'sculpted', 'wallpapers', 'banners', 'previews', 'logos']

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description,
  url: canonical,
  isPartOf: {
    '@type': 'WebSite',
    name: 'Santi020k Themes',
    url: 'https://theme.santi020k.com/'
  }
}

const structuredDataJson = JSON.stringify(structuredData).replace(/</g, '\\u003c')
---

<!doctype html>
<html lang="en" data-santi020k-site="hub">
  <head>
    <PageTransitions page="hub" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Santiago Molina" />
    <meta name="language" content="en" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="color-scheme" content="dark light" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@300..700&display=swap" rel="stylesheet" />
    <meta name="theme-color" content="#110c1d" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f8f6fd" media="(prefers-color-scheme: light)" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Santi020k Themes" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Wallpapers, banners, previews, and brand assets in one calm violet collection." />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@santi020k" />
    <meta name="twitter:creator" content="@santi020k" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content="Wallpapers, banners, previews, and brand assets in one calm violet collection." />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <script is:inline type="application/ld+json" set:html={structuredDataJson}></script>
  </head>
  <body data-gallery-page>
    <SharedHeader />

    <main id="top">
      <section class="site-shell gallery-hero" aria-labelledby="gallery-hero-title">
        <div class="gallery-hero-copy">
          <Eyebrow class="eyebrow">{archive ? 'The earlier collection' : 'Gallery & downloads'}</Eyebrow>
          <h1 id="gallery-hero-title">{archive ? 'The Classic archive.' : 'A quieter kind of screen.'}</h1>
          <p class="lede">{archive ? 'The original wallpapers, kept here for anyone who still enjoys them. Every previous download remains available.' : 'Eight considered designs. Light and dark. Desktop and phone. Find a wallpaper you want to live with, then choose the file that fits your screen.'}</p>
          <div class="collection-downloads" aria-label="Collection downloads">
            <ButtonLink class="button button-primary" variant="primary" href={archive ? '/gallery/' : '#asset-library'}>{archive ? 'Explore current designs' : 'Find your wallpaper'}</ButtonLink>
            {!archive && (
<>
            <ButtonLink class="button button-secondary" variant="secondary" href="/downloads/santi020k-minimal-wallpapers-v2.zip" download>Minimal WEBP pack</ButtonLink>
            <ButtonLink class="button button-secondary" variant="secondary" href="/downloads/santi020k-signature-wallpapers-v2.zip" download>Signature WEBP pack</ButtonLink>
            <ButtonLink class="button button-secondary" variant="secondary" href="/downloads/santi020k-sculpted-wallpapers-v2.zip" download>Sculpted WEBP pack</ButtonLink>
            <ButtonLink class="button button-secondary" variant="secondary" href="/downloads/santi020k-banners.zip" download>Banners ZIP</ButtonLink>
            </>
)}
            {archive && <ButtonLink class="button button-secondary" variant="secondary" href="/downloads/santi020k-wallpapers.zip" download>Classic wallpapers ZIP</ButtonLink>}
          </div>
        </div>
        <aside class="gallery-hero-index" aria-label="Gallery summary">
          <Eyebrow class="gallery-index-label">Available now</Eyebrow>
          <dl>
            <div><dt>{archive ? assets.length : wallpaperDesigns.length}</dt><dd>{archive ? 'archived wallpapers' : 'wallpaper designs'}</dd></div>
            {!archive && <div><dt>{wallpaperDesigns.length * 4}</dt><dd>wallpaper versions</dd></div>}
            <div><dt>{archive ? 4 : 3}</dt><dd>{archive ? 'file formats' : 'current collections'}</dd></div>
          </dl>
          <p>{archive ? 'PNG · WEBP · SVG · HEIC' : 'PNG · WEBP · JPG'}</p>
        </aside>
      </section>

      <section id="asset-library" class="site-shell gallery-section" aria-labelledby="gallery-heading">
        <div class="gallery-toolbar">
          <div class="gallery-toolbar-copy"><Eyebrow class="eyebrow">{archive ? 'Archive' : 'The collection'}</Eyebrow><h2 id="gallery-heading">{archive ? 'Where it started.' : 'Find your quiet.'}</h2><p>{archive ? 'Original files and formats, preserved at their existing URLs.' : 'Open a design to explore all four versions and choose a format, quality, and resolution. Banners, previews, and brand assets are here too.'}</p></div>
          <div class="gallery-controls">
            <div class="filter-group" role="group" aria-label="Filter assets">
              {['all', ...categories].map((filter, index) => <Button class="filter-button" type="button" data-filter={filter} aria-pressed={index === 0 ? 'true' : 'false'}><span>{filter === 'all' ? 'All assets' : filter.charAt(0).toUpperCase() + filter.slice(1)}</span><span class="filter-count" aria-hidden="true">{filter === 'all' ? assets.length : assets.filter(asset => asset.category === filter || ('collection' in asset && asset.collection === filter)).length}</span></Button>)}
            </div>
            <p class="gallery-count" aria-live="polite"><strong data-gallery-count>{assets.length}</strong> <span data-gallery-count-label>assets shown</span></p>
          </div>
        </div>
        <div class="asset-grid">
          {assets.map(asset => (
            <Card as="article" class:list={['asset-card', { 'asset-card-portrait': 'portrait' in asset && asset.portrait }]} data-category={asset.category} data-collection={'collection' in asset ? asset.collection : undefined}>
              <Button class:list={['asset-preview', { 'asset-preview-contain': ('contain' in asset && asset.contain) || ('portrait' in asset && asset.portrait) }]} type="button" data-preview-src={asset.preview.src} data-preview-alt={`${asset.title}, ${asset.variant}`} data-preview-title={`${asset.title} — ${asset.variant}`} aria-label={`Preview ${asset.title}, ${asset.variant}`}>
                <Image src={asset.preview} alt={asset.design?.alt ?? ''} loading="lazy" />
                <span class="preview-label">Open preview</span>
              </Button>
              <div class="asset-card-body">
                <div><p class="asset-category"><span>{'collection' in asset ? `${asset.collection.charAt(0).toUpperCase() + asset.collection.slice(1)} wallpaper` : asset.category}</span><span>{asset.design ? '4 versions' : asset.variant}</span></p><h3>{asset.design ? <a href={wallpaperHref(asset.design.slug)}>{asset.design.name}</a> : asset.title}</h3><p class="asset-meta">{asset.design?.tagline ?? asset.dimensions}</p></div>
                {asset.design ?
<a class="gallery-design-link" href={wallpaperHref(asset.design.slug)}>Explore & download {asset.design.name}<Icon name="arrow-up-right" /></a> :
(
<div class="asset-formats" aria-label={`Download ${asset.title} formats`}>
                  {asset.formats.map(format => <Link href={format.href} download={format.file} title={`Download ${asset.title} as ${format.label}`}>{format.label}<Icon name="download" class="asset-format-icon" /></Link>)}
                </div>
)}
              </div>
            </Card>
          ))}
        </div>
        <p class="gallery-empty" hidden>No assets match this filter.</p>
        {!archive && <div class="gallery-archive-link"><p>Looking for an earlier wallpaper?</p><a href="/gallery/archive/">Browse the Classic archive</a></div>}
      </section>
    </main>

    <Dialog class="asset-dialog" aria-labelledby="asset-dialog-title">
      <div class="dialog-header"><div><Eyebrow class="eyebrow">Full preview</Eyebrow><h2 id="asset-dialog-title"></h2></div><Button class="dialog-close" type="button" aria-label="Close preview"><Icon name="x" /></Button></div>
      <div class="dialog-media"><img alt="" /></div>
    </Dialog>

    <BackToTop class="back-to-top" aria-label="Back to top"><Icon name="chevron-up" /></BackToTop>

    <SharedFooter />
    <script>import '../main.js'
</script>
    <UIPrimitives />
  </body>
</html>

<style>
  :global([data-gallery-page] .gallery-hero h1) {
    font-size: clamp(3rem, 6vw, 5.5rem);
    font-weight: 500;
    letter-spacing: -.065em;
    line-height: 1.04;
  }

  :global([data-gallery-page] .gallery-toolbar h2) {
    font-weight: 500;
    letter-spacing: -.055em;
  }

  :global([data-gallery-page] .gallery-hero-index) {
    border-color: var(--site-line);
  }

  :global([data-gallery-page] .gallery-hero-index dt),
  :global([data-gallery-page] .gallery-hero-index dd),
  :global([data-gallery-page] .gallery-index-label),
  :global([data-gallery-page] .gallery-hero-index > p:last-child) {
    font-weight: 500;
  }

  :global([data-gallery-page] .button-primary) {
    background: var(--site-ink);
    border-color: var(--site-ink);
    color: var(--theme-bg);
    box-shadow: none;
  }

  :global([data-gallery-page] .button-secondary),
  :global([data-gallery-page] .filter-button),
  :global([data-gallery-page] .asset-formats a) {
    min-height: 44px;
    border-radius: 1rem;
    background: var(--site-surface);
    box-shadow: none;
    font-weight: 500;
  }

  :global([data-gallery-page] .filter-button[aria-pressed="true"]) {
    background: var(--site-ink);
    border-color: var(--site-ink);
    color: var(--theme-bg);
  }

  :global([data-gallery-page] .filter-button[aria-pressed="true"] .filter-count) {
    background: var(--theme-bg);
    color: var(--site-ink);
  }

  :global([data-gallery-page] .asset-grid) {
    gap: 1.5rem;
  }

  :global([data-gallery-page] .asset-card),
  :global([data-gallery-page] .asset-card:hover),
  :global([data-gallery-page] .asset-card:focus-within) {
    border-radius: 1.5rem;
    background: var(--site-surface);
    box-shadow: none;
    transform: none;
    transition: border-color 200ms ease;
  }

  :global([data-gallery-page] .asset-preview) {
    background: var(--site-surface-muted);
    background-image: none;
  }

  :global([data-gallery-page] .asset-card-body) {
    padding: 1.5rem;
  }

  :global([data-gallery-page] .asset-card-body h3),
  :global([data-gallery-page] .preview-label) {
    font-weight: 500;
  }

  :global([data-gallery-page] .asset-dialog) {
    border-color: var(--site-line);
    border-radius: 1.5rem;
  }

  :global([data-gallery-page] .asset-dialog::backdrop) {
    backdrop-filter: none;
  }

  :global([data-gallery-page] button:focus-visible),
  :global([data-gallery-page] a:focus-visible) {
    outline: 2px solid var(--site-accent);
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    :global([data-gallery-page] .asset-card),
    :global([data-gallery-page] .asset-preview img),
    :global([data-gallery-page] .asset-preview:hover img),
    :global([data-gallery-page] .preview-label) {
      transition: none;
      transform: none;
    }
  }
</style>
