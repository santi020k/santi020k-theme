---
import { Icon, Link } from '@santi020k/lumen-astro'

import { products } from '../data/products.js'

import Brand from './Brand.astro'

const editorSlugs = new Set(['vscode', 'zed', 'jetbrains', 'xcode', 'codex', 'neovim'])
const editorThemes = products.filter(product => editorSlugs.has(product.slug))
const workspaceThemes = products.filter(product => !editorSlugs.has(product.slug))
---

<footer class="family-footer">
  <div class="site-shell family-footer-callout">
    <div class="family-footer-callout-copy">
      <p class="family-footer-eyebrow">Make yourself at home</p>
      <h2>A little more violet.<br />A little more you.</h2>
      <p>Find a wallpaper to pair with your theme. Made for your desktop, your phone, and the spaces in between.</p>
    </div>
    <div class="family-footer-callout-actions">
      <Link class="family-footer-primary" href="/gallery/">Explore the gallery <Icon name="arrow-right" /></Link>
      <Link class="family-footer-secondary" href="https://github.com/santi020k/santi020k-theme" newTab>View on GitHub</Link>
    </div>
    <div class="family-footer-palette" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
  </div>

  <div class="site-shell family-footer-grid">
    <div class="family-footer-brand">
      <Brand />
      <p>Calm contrast for the tools you use every day.</p>
      <Link class="family-footer-author" href="https://santi020k.com" newTab>Made by Santiago Molina <Icon name="arrow-up-right" /></Link>
    </div>

    <nav aria-label="Editor themes">
      <b>Editors &amp; coding</b>
      <div>{editorThemes.map(product => <Link href={`/${product.slug}/`}>{product.name}</Link>)}</div>
    </nav>

    <nav aria-label="Workspace themes">
      <b>Workspace</b>
      <div>{workspaceThemes.map(product => <Link href={`/${product.slug}/`}>{product.name}</Link>)}</div>
    </nav>

    <nav aria-label="Project links">
      <b>Explore</b>
      <div><Link href="/">Home</Link><Link href="/gallery/">Gallery</Link><Link href="/design/">Design guide</Link><Link href="/terminal/docs/">Terminal docs</Link><Link href="/support/">Feedback &amp; support</Link><Link href="https://santi020k.com" newTab>About Santi020k</Link></div>
    </nav>
  </div>

  <div class="site-shell family-footer-meta">
    <span>© {new Date().getFullYear()} Santiago Molina · Free &amp; open source</span>
    <span>Designed as one family · Built with <Link href="https://lumen.santi020k.com" newTab>Lumen</Link></span>
  </div>
</footer>

<style>
  .family-footer {
    display: block;
    min-height: 0;
    margin-top: 0;
    padding-top: clamp(28px, 4vw, 48px);
    border-top: 1px solid var(--section-divider);
    background: var(--theme-bg);
    color: var(--site-ink-soft);
  }
  .family-footer-callout {
    position: relative;
    display: grid;
    overflow: hidden;
    width: var(--site-shell-width);
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 32px;
    align-items: center;
    margin-inline: auto;
    padding: clamp(26px, 3.5vw, 38px);
    border: 1px solid color-mix(in srgb, var(--site-brand) 40%, var(--site-line));
    border-radius: 1.75rem;
    background: var(--site-surface-muted);

  }
  .family-footer-callout-copy { display: block; min-width: 0; }
  .family-footer-callout h2 {
    max-width: 28ch;
    margin: 0;
    color: var(--site-ink);
    font-size: clamp(1.45rem, 2.3vw, 2.1rem);
    font-weight: 500;
    letter-spacing: -.065em;
    line-height: 1.12;
  }
  .family-footer-callout p:not(.family-footer-eyebrow) {
    max-width: 680px;
    margin: 10px 0 0;
    line-height: 1.55;
  }
  .family-footer-eyebrow {
    margin: 0 0 9px;
    color: var(--site-brand);
    font-size: .625rem;
    font-weight: 600;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  .family-footer-callout-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: flex-end;
  }
  .family-footer-callout-actions a {
    display: inline-flex;
    min-height: 44px;
    gap: 9px;
    align-items: center;
    justify-content: center;
    padding: 0 18px;
    border: 1px solid var(--site-line);
    border-radius: 1rem;
    font-size: .84rem;
    font-weight: 500;
    text-decoration: none;
  }
  .family-footer-callout-actions a:global(.family-footer-primary) {
    border-color: var(--site-ink);
    background: var(--site-ink);
    color: var(--theme-bg);
  }
  .family-footer-callout-actions a:global(.family-footer-primary:hover) { background: var(--site-ink-soft); }
  .family-footer-callout-actions a:global(.family-footer-secondary) {
    background: var(--btn-secondary-bg);
    color: var(--site-ink);
  }
  .family-footer-callout-actions :global(svg) { width: 16px; }
  .family-footer-callout h2 { font-weight: 500; }
  .family-footer-palette {
    position: absolute;
    right: 30px;
    bottom: -8px;
    display: flex;
    gap: 6px;
    opacity: .45;
    pointer-events: none;
  }
  .family-footer-palette i {
    width: 30px;
    height: 7px;
    border-radius: 999px;
    background: var(--site-brand-solid);
  }
  .family-footer-palette i:nth-child(2) { background: var(--site-brand); }
  .family-footer-palette i:nth-child(3) { background: var(--site-accent); }
  .family-footer-palette i:nth-child(4) { background: var(--site-success); }
  .family-footer-palette i:nth-child(5) { background: var(--site-warning); }
  .family-footer-grid {
    display: grid;
    width: var(--site-shell-width);
    grid-template-columns: minmax(260px, 1.35fr) .75fr .65fr .75fr;
    gap: clamp(34px, 6vw, 76px);
    margin: 0 auto;
    padding-block: 64px;
  }
  .family-footer-brand { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; max-width: 310px; }
  .family-footer-brand > p { margin: 0; max-width: 27ch; font-size: .9rem; line-height: 1.75; }
  .family-footer-brand :global(.family-footer-author) { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; font-size: .75rem; font-weight: 500; }
  .family-footer-author :global(svg) { width: 16px; height: 16px; }
  .family-footer nav {
    display: grid;
    align-content: start;
    gap: 18px;
  }
  .family-footer nav b {
    color: var(--site-ink);
    font-size: .8rem;
  }
  .family-footer nav div {
    display: grid;
    gap: 4px;
  }
  .family-footer a {
    color: inherit;
    text-decoration: none;
  }
  .family-footer nav a { display: inline-flex; min-height: 44px; align-items: center; font-size: .84rem; }
  .family-footer nav a:hover,
  .family-footer-meta a:hover { color: var(--site-brand); }
  .family-footer-meta {
    display: flex;
    width: var(--site-shell-width);
    min-height: 70px;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-inline: auto;
    border-top: 1px solid var(--section-divider);
    font-size: .74rem;
  }
  @media (max-width: 900px) {
    .family-footer-callout { grid-template-columns: 1fr; }
    .family-footer-callout-actions { justify-content: flex-start; }
    .family-footer-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 30px;
    }
    .family-footer-brand { grid-column: 1 / -1; }
  }
  @media (max-width: 700px) {
    .family-footer-callout { padding: 26px 22px 30px; }
    .family-footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin-top: 0;
    }
    .family-footer-brand { grid-column: 1 / -1; }
  }
  @media (max-width: 460px) {
    .family-footer-callout-actions {
      align-items: stretch;
      flex-direction: column;
    }
    .family-footer-grid { grid-template-columns: 1fr 1fr; }
    .family-footer nav:last-child { grid-column: 1 / -1; }
    .family-footer-meta {
      align-items: flex-start;
      flex-direction: column;
      justify-content: center;
      padding-block: 18px;
    }
  }
</style>
