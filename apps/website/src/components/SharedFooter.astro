---
import { Icon, Link } from '@santi020k/lumen-astro'

import { products } from '../data/products.js'

const editorSlugs = new Set(['vscode', 'zed', 'jetbrains', 'xcode', 'codex'])
const editorThemes = products.filter(product => editorSlugs.has(product.slug))
const workspaceThemes = products.filter(product => !editorSlugs.has(product.slug))
---

<footer class="family-footer">
  <div class="site-shell family-footer-callout">
    <div>
      <p class="family-footer-eyebrow">The complete theme family</p>
      <h2>Keep every workspace in the same calm rhythm.</h2>
      <p>One violet system, carefully adapted for the tools you move through every day.</p>
    </div>
    <div class="family-footer-callout-actions">
      <Link class="family-footer-primary" href="/gallery/">Explore the gallery <Icon name="arrow-right" /></Link>
      <Link class="family-footer-secondary" href="https://github.com/santi020k/santi020k-theme" rel="noopener noreferrer">View on GitHub</Link>
    </div>
    <div class="family-footer-palette" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
  </div>

  <div class="site-shell family-footer-grid">
    <div class="family-footer-brand">
      <Link class="family-footer-logo" href="/" aria-label="Santi020k Themes home">
        <svg viewBox="0 0 80 80" aria-hidden="true" focusable="false"><rect width="80" height="80" rx="18" fill="currentColor" /><path d="M26 28 L40 40 L26 52" fill="none" stroke="var(--site-brand-mark-ink)" stroke-width="8" stroke-linecap="round" stroke-linejoin="round" /><line x1="48" y1="52" x2="62" y2="52" stroke="var(--site-brand-mark-ink)" stroke-width="8" stroke-linecap="round" /></svg>
        <span>Santi020k <b>Themes</b></span>
      </Link>
      <p>
        A cohesive dark and light theme family for editors, terminals, browsers, launchers, and collaboration tools.
      </p>
      <span class="family-footer-open"><i aria-hidden="true"></i> Free and open source</span>
    </div>

    <nav aria-label="Editor themes">
      <b>Editors &amp; coding</b>
      <div>{editorThemes.map(product => <Link href={`/${product.slug}/`}>{product.name}</Link>)}</div>
    </nav>

    <nav aria-label="Workspace themes">
      <b>Workspace</b>
      <div>{workspaceThemes.map(product => <Link href={`/${product.slug}/`}>{product.name}</Link>)}</div>
    </nav>

    <nav aria-label="Project links">
      <b>Explore</b>
      <div><Link href="/">Home</Link><Link href="/gallery/">Gallery</Link><Link href="/terminal/docs/">Documentation</Link><Link href="https://santi020k.com" rel="noopener noreferrer">About Santi020k</Link></div>
    </nav>
  </div>

  <div class="site-shell family-footer-meta">
    <span>© {new Date().getFullYear()} Santiago Molina</span>
    <span>Designed as one family · Built with <Link href="https://lumen.santi020k.com" rel="noopener noreferrer">Lumen</Link></span>
  </div>
</footer>

<style>
  .family-footer {
    display: block;
    min-height: 0;
    margin-top: 0;
    padding-top: clamp(28px, 4vw, 48px);
    border-top: 1px solid var(--section-divider);
    background:
      radial-gradient(circle at 16% 18%, color-mix(in srgb, var(--site-brand) 11%, transparent), transparent 28rem),
      color-mix(in srgb, var(--site-surface) 74%, var(--theme-bg));
    color: var(--site-ink-soft);
  }
  .family-footer-callout {
    position: relative;
    display: grid;
    overflow: hidden;
    width: var(--site-shell-width);
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 32px;
    align-items: center;
    margin-inline: auto;
    padding: clamp(26px, 3.5vw, 38px);
    border: 1px solid color-mix(in srgb, var(--site-brand) 40%, var(--site-line));
    border-radius: 22px;
    background: linear-gradient(
      120deg,
      color-mix(in srgb, var(--site-brand-solid) 18%, var(--site-surface)),
      color-mix(in srgb, var(--site-surface) 94%, var(--theme-bg)) 64%
    );
    box-shadow: 0 28px 90px color-mix(in srgb, #000 20%, transparent);
  }
  .family-footer-callout h2 {
    max-width: 28ch;
    margin: 0;
    color: var(--site-ink);
    font-size: clamp(1.45rem, 2.3vw, 2.1rem);
    letter-spacing: -.035em;
    line-height: 1.12;
  }
  .family-footer-callout p:not(.family-footer-eyebrow) {
    max-width: 680px;
    margin: 10px 0 0;
    line-height: 1.55;
  }
  .family-footer-eyebrow {
    margin: 0 0 9px;
    color: var(--site-brand);
    font-size: .7rem;
    font-weight: 850;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  .family-footer-callout-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: flex-end;
  }
  .family-footer-callout-actions a {
    display: inline-flex;
    min-height: 44px;
    gap: 9px;
    align-items: center;
    justify-content: center;
    padding: 0 18px;
    border: 1px solid var(--site-line);
    border-radius: 9px;
    font-size: .84rem;
    font-weight: 800;
    text-decoration: none;
  }
  .family-footer-callout-actions a:global(.family-footer-primary) {
    border-color: var(--site-brand-solid);
    background: var(--site-brand-solid);
    color: #fff;
  }
  .family-footer-callout-actions a:global(.family-footer-primary:hover) { background: var(--site-brand-hover); }
  .family-footer-callout-actions a:global(.family-footer-secondary) {
    background: var(--btn-secondary-bg);
    color: var(--site-ink);
  }
  .family-footer-callout-actions :global(svg) { width: 16px; }
  .family-footer-palette {
    position: absolute;
    right: 30px;
    bottom: -8px;
    display: flex;
    gap: 6px;
    opacity: .45;
    pointer-events: none;
  }
  .family-footer-palette i {
    width: 30px;
    height: 7px;
    border-radius: 999px;
    background: var(--site-brand-solid);
  }
  .family-footer-palette i:nth-child(2) { background: var(--site-brand); }
  .family-footer-palette i:nth-child(3) { background: var(--site-accent); }
  .family-footer-palette i:nth-child(4) { background: var(--site-success); }
  .family-footer-palette i:nth-child(5) { background: var(--site-warning); }
  .family-footer-grid {
    display: grid;
    width: var(--site-shell-width);
    grid-template-columns: minmax(260px, 1.35fr) .75fr .65fr .75fr;
    gap: clamp(34px, 6vw, 76px);
    margin: 0 auto;
    padding-block: 38px 48px;
  }
  .family-footer-brand { max-width: 390px; }
  .family-footer-brand :global(.family-footer-logo) {
    display: inline-flex;
    gap: 11px;
    align-items: center;
    color: var(--site-ink);
    font-weight: 850;
  }
  .family-footer-brand :global(.family-footer-logo) svg {
    width: 36px;
    height: 36px;
    color: var(--site-brand-solid);
  }
  .family-footer-brand :global(.family-footer-logo) b { color: var(--site-brand); }
  .family-footer-brand > p {
    margin: 18px 0;
    line-height: 1.7;
  }
  .family-footer-open {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    font-size: .76rem;
    font-weight: 750;
  }
  .family-footer-open i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--site-success);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--site-success) 14%, transparent);
  }
  .family-footer nav {
    display: grid;
    align-content: start;
    gap: 18px;
  }
  .family-footer nav b {
    color: var(--site-ink);
    font-size: .8rem;
  }
  .family-footer nav div {
    display: grid;
    gap: 12px;
  }
  .family-footer a {
    color: inherit;
    text-decoration: none;
  }
  .family-footer nav a { font-size: .84rem; }
  .family-footer nav a:hover,
  .family-footer-meta a:hover { color: var(--site-brand); }
  .family-footer-meta {
    display: flex;
    width: var(--site-shell-width);
    min-height: 70px;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-inline: auto;
    border-top: 1px solid var(--section-divider);
    font-size: .74rem;
  }
  @media (max-width: 900px) {
    .family-footer-callout { grid-template-columns: 1fr; }
    .family-footer-callout-actions { justify-content: flex-start; }
    .family-footer-grid {
      grid-template-columns: 1.2fr repeat(3, .7fr);
      gap: 30px;
    }
  }
  @media (max-width: 700px) {
    .family-footer-callout { padding: 26px 22px 30px; }
    .family-footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin-top: 0;
    }
    .family-footer-brand { grid-column: 1 / -1; }
  }
  @media (max-width: 460px) {
    .family-footer-callout-actions {
      align-items: stretch;
      flex-direction: column;
    }
    .family-footer-grid { grid-template-columns: 1fr 1fr; }
    .family-footer nav:last-child { grid-column: 1 / -1; }
    .family-footer-meta {
      align-items: flex-start;
      flex-direction: column;
      justify-content: center;
      padding-block: 18px;
    }
  }
</style>
