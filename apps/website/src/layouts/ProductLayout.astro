---
import '../styles.css'

import UIPrimitives from '@santi020k/lumen-astro/runtime'
import MetadataHead from '@santi020k/og/astro/head'
import { personSchema, serializeJsonLd, softwareApplicationSchema } from '@santi020k/og/schema'
import { defineSite } from '@santi020k/og/site'

import PageTransitions from '../components/PageTransitions.astro'
import SharedFooter from '../components/SharedFooter.astro'
import SharedHeader from '../components/SharedHeader.astro'

interface Props {
  applicationCategory?: 'DeveloperApplication' | 'ProductivityApplication'
  pageKind?: 'product' | 'guide'
  description: string
  name: string
  slug: string
  title: string
}

const { description, name, slug, title, pageKind = 'product', applicationCategory = 'DeveloperApplication' } = Astro.props
const canonical = `https://theme.santi020k.com/${slug}/`
const socialImage = `https://theme.santi020k.com/og-${slug === 'gallery/appearance' ? 'appearance' : slug}.png`

const site = defineSite({
  locale: 'en_US',
  siteName: 'Santi020k Themes',
  siteUrl: 'https://theme.santi020k.com',
  twitter: { creator: '@santi020k', site: '@santi020k' }
})

const page = site.page({
  canonical,
  description,
  image: { alt: `Santi020k Theme for ${name}`, url: socialImage },
  pathname: `/${slug}/`,
  title
})

const structuredData = serializeJsonLd(pageKind === 'guide' ?
{
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: canonical
} :
softwareApplicationSchema({
  name: `Santi020k Theme for ${name}`,
  url: canonical,
  description,
  applicationCategory,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: personSchema({ name: 'Santiago Molina', url: 'https://santi020k.com/' })
}))
---

<!doctype html>
<html lang="en" data-santi020k-site="hub">
  <head>
    <PageTransitions page="hub" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <MetadataHead {page} site={site.options} />
    <meta name="author" content="Santiago Molina" />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#110c1d" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f8f6fd" media="(prefers-color-scheme: light)" />
    <script is:inline type="application/ld+json" set:html={structuredData}></script>
  </head>
  <body>
    <SharedHeader currentProduct={slug} productLinks={[{ href: `/${slug}/`, label: 'Overview' }, { href: `/${slug}/#install`, label: 'Install' }, { href: `/${slug}/#coverage`, label: 'Coverage' }]} />
    <main><slot /></main>
    <SharedFooter />
    <script>
      import '../main.js'
    </script>
    <UIPrimitives />
  </body>
</html>
