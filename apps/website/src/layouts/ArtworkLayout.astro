---
import '../styles.css'

import UIPrimitives from '@santi020k/lumen-astro/runtime'
import MetadataHead from '@santi020k/og/astro/head'
import { serializeJsonLd } from '@santi020k/og/schema'
import { defineSite } from '@santi020k/og/site'

import PageTransitions from '../components/PageTransitions.astro'
import SharedFooter from '../components/SharedFooter.astro'
import SharedHeader from '../components/SharedHeader.astro'

interface Props {
  title: string
  description: string
  pathname: string
  image?: string
  imageAlt?: string
  structuredData?: Parameters<typeof serializeJsonLd>[0]
}

const { title, description, pathname, image = '/og-image.png', imageAlt = 'Santi020k wallpaper gallery', structuredData } = Astro.props
const site = defineSite({ locale: 'en_US', siteName: 'Santi020k Themes', siteUrl: 'https://theme.santi020k.com', twitter: { creator: '@santi020k', site: '@santi020k' } })
const canonical = new URL(pathname, site.options.siteUrl).href
const page = site.page({ canonical, description, image: { alt: imageAlt, url: new URL(image, canonical).href }, pathname, title })
---
<!doctype html>
<html lang="en" data-santi020k-site="hub">
  <head>
    <PageTransitions page="hub" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <MetadataHead {page} site={site.options} />
    <meta name="author" content="Santiago Molina" />
    <meta name="color-scheme" content="dark light" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#110c1d" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f8f6fd" media="(prefers-color-scheme: light)" />
    {structuredData && <script is:inline type="application/ld+json" set:html={serializeJsonLd(structuredData)}></script>}
  </head>
  <body>
    <SharedHeader />
    <main class="artwork-page"><slot /></main>
    <SharedFooter />
    <script>import '../main.js'
</script>
    <UIPrimitives />
  </body>
</html>
