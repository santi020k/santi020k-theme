---
import { Image } from 'astro:assets'

import '../styles.css'
import '../styles/home.css'

import { ButtonLink, Card, Eyebrow, Icon, Link, Particles, RevealGroup, ScrollReveal } from '@santi020k/lumen-astro'
import UIPrimitives from '@santi020k/lumen-astro/runtime'

import duneWallpaper from '../../../../packages/theme/assets/wallpapers/sculpted-v2/dune-light-desktop.webp'
import duneDownload from '../../../../packages/theme/assets/wallpapers/sculpted-v2/dune-light-desktop.webp?url'
import ceramicWallpaper from '../../../../packages/theme/assets/wallpapers/signature-v2/ceramic-light-desktop.webp'
import ceramicDownload from '../../../../packages/theme/assets/wallpapers/signature-v2/ceramic-light-desktop.webp?url'
import satinWallpaper from '../../../../packages/theme/assets/wallpapers/signature-v2/satin-dark-desktop.webp'
import satinDownload from '../../../../packages/theme/assets/wallpapers/signature-v2/satin-dark-desktop.webp?url'
import heroArtwork from '../../public/hub-hero-art.png'
import PageTransitions from '../components/PageTransitions.astro'
import SharedFooter from '../components/SharedFooter.astro'
import SharedHeader from '../components/SharedHeader.astro'
import ThemeCardPreview from '../components/ThemeCardPreview.astro'
import { products } from '../data/products.js'

const featuredWallpapers = [
  { image: ceramicWallpaper, name: 'Ceramic', collection: 'Signature', edition: 'Light', filename: 'santi020k-signature-ceramic-light-desktop.webp', download: ceramicDownload, description: 'A violet prompt tile among pale sculptural ceramic forms' },
  { image: satinWallpaper, name: 'Satin', collection: 'Signature', edition: 'Dark', filename: 'santi020k-signature-satin-dark-desktop.webp', download: satinDownload, description: 'A violet prompt tile resting in rich indigo satin folds' },
  { image: duneWallpaper, name: 'Dune', collection: 'Sculpted', edition: 'Light', filename: 'santi020k-sculpted-dune-light-desktop.webp', download: duneDownload, description: 'Soft lavender dunes beneath a warm pastel sky' }
]

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Santi020k Themes',
  url: 'https://theme.santi020k.com/',
  description: 'The hub for Santi020k visual themes across editors, terminals, browsers, launchers, and collaboration tools.',
  author: {
    '@type': 'Person',
    name: 'Santiago Molina',
    url: 'https://santi020k.com',
    sameAs: ['https://github.com/santi020k', 'https://twitter.com/santi020k']
  },
  hasPart: [
    {
      '@type': 'SoftwareApplication',
      name: 'Santi020k Theme for VS Code',
      url: 'https://theme.santi020k.com/vscode/',
      applicationCategory: 'DeveloperApplication'
    },
    {
      '@type': 'SoftwareApplication',
      name: 'Santi020k Theme for Chrome',
      url: 'https://theme.santi020k.com/chrome/',
      applicationCategory: 'BrowserApplication'
    },
    {
      '@type': 'SoftwareApplication',
      name: 'Santi020k Theme for iTerm2',
      url: 'https://theme.santi020k.com/terminal/',
      applicationCategory: 'DeveloperApplication'
    },
    {
      '@type': 'SoftwareApplication',
      name: 'Santi020k Theme for Zed',
      url: 'https://theme.santi020k.com/zed/',
      applicationCategory: 'DeveloperApplication'
    },
    {
      '@type': 'SoftwareApplication',
      name: 'Santi020k Theme for Codex',
      url: 'https://theme.santi020k.com/codex/',
      applicationCategory: 'DeveloperApplication'
    },
    ...products.slice(5).map(product => ({
      '@type': product.slug === 'iphone' ? 'WebPage' : 'SoftwareApplication',
      name: `Santi020k Theme for ${product.name}`,
      url: `https://theme.santi020k.com/${product.slug}/`,
      ...(product.slug === 'iphone' ? {} : { applicationCategory: product.slug === 'obsidian' ? 'ProductivityApplication' : 'DeveloperApplication' })
    })),
    {
      '@type': 'SoftwareSourceCode',
      name: '@santi020k/theme',
      url: 'https://github.com/santi020k/santi020k-theme',
      codeRepository: 'https://github.com/santi020k/santi020k-theme',
      programmingLanguage: ['CSS', 'JavaScript', 'TypeScript']
    }
  ]
}

const structuredDataJson = JSON.stringify(structuredData).replace(/</g, '\\u003c')
---

<!doctype html>
<html lang="en" data-santi020k-site="hub">
  <head>
    <PageTransitions page="hub" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Santi020k Themes — One violet system across your tools</title>
    <meta name="description" content="The Santi020k theme family hub: coordinated themes for editors, terminals, browsers, launchers, and collaboration tools." />
    <meta name="author" content="Santiago Molina" />
    <meta name="language" content="en" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="color-scheme" content="dark light" />
    <link rel="canonical" href="https://theme.santi020k.com/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#110c1d" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f8f6fd" media="(prefers-color-scheme: light)" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://theme.santi020k.com/" />
    <meta property="og:site_name" content="Santi020k Themes" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content="Santi020k Themes — One violet system across your tools" />
    <meta property="og:description" content="A coordinated theme family for editors, terminals, browsers, launchers, and collaboration tools." />
    <meta property="og:image" content="https://theme.santi020k.com/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Santi020k Themes hub" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@santi020k" />
    <meta name="twitter:creator" content="@santi020k" />
    <meta name="twitter:url" content="https://theme.santi020k.com/" />
    <meta name="twitter:title" content="Santi020k Themes" />
    <meta name="twitter:description" content="A coordinated theme family for editors, terminals, browsers, launchers, and collaboration tools." />
    <meta name="twitter:image" content="https://theme.santi020k.com/og-image.png" />
    <meta name="twitter:image:alt" content="The Santi020k theme family across editors, browsers, terminals, and developer tools" />
    <script is:inline type="application/ld+json" set:html={structuredDataJson}></script>
  </head>
  <body>
    <SharedHeader />

    <main id="top" class="home-page">
      <section class="site-shell home-hero" aria-labelledby="home-title">
        <Particles class="home-bubbles" density="low" />
        <ScrollReveal class="home-hero-copy" animation="slide-up" duration="standard" threshold={0}>
          <Eyebrow class="home-eyebrow"><span>01</span> / A considered workspace</Eyebrow>
          <h1 id="home-title">A calmer place<br />to <span>create.</span></h1>
          <p class="home-lede">One violet palette for the editors, terminals, and tools you make things with. Thoughtful contrast, wherever you work.</p>
          <div class="home-actions" aria-label="Primary theme links">
            <ButtonLink class="home-button home-button-primary" variant="unstyled" href="#themes">Browse themes <span class="home-arrow"><Icon name="arrow-up-right" /></span></ButtonLink>
            <ButtonLink class="home-button home-text-link" variant="unstyled" href="/gallery/">Explore the gallery <Icon name="arrow-right" /></ButtonLink>
          </div>
        </ScrollReveal>
        <figure class="home-hero-art">
          <Image src={heroArtwork} alt="Violet editor and browser windows in an abstract Santi020k workspace" widths={[640, 960, 1440]} sizes="(max-width: 767px) 92vw, 48vw" loading="eager" fetchpriority="high" />
          <figcaption><span>Santi020k Theme</span><span>A shared visual language</span></figcaption>
        </figure>
        <ul class="home-workspace-details" aria-label="Theme family at a glance">
          <li><span>{String(products.length).padStart(2, '0')}</span> surfaces, one palette</li>
          <li><Icon name="sun-moon" /> Dark &amp; light</li>
          <li><Icon name="palette" /> One violet foundation</li>
        </ul>
      </section>

      <section id="themes" class="site-shell home-section" aria-labelledby="themes-title">
        <div class="home-section-heading">
          <div>
            <Eyebrow class="home-eyebrow"><span>02</span> / The theme family</Eyebrow>
            <h2 id="themes-title">Different tools.<br />The same feeling.</h2>
          </div>
          <p class="home-section-intro">Start with your editor. Bring the same considered palette to the rest of your workspace.</p>
        </div>
        <RevealGroup class="home-theme-grid" animation="fade" duration="standard" stagger={35} threshold={0}>
          {products.map((product, index) => (
            <Card as="article" variant="unstyled" class:list={['home-tool', { 'home-tool-featured': index === 0 }]} data-product={product.slug}>
              <Link class="home-tool-link" variant="inherit" href={`/${product.slug}/`} aria-label={`View the ${product.name} theme`}>
                <div class="home-tool-preview"><ThemeCardPreview slug={product.slug} name={product.name} featured={index === 0} /></div>
                <div class="home-tool-copy">
                  <div class="home-tool-meta"><span>{String(index + 1).padStart(2, '0')} / {product.category}</span>{index === 0 && <span>The original theme</span>}</div>
                  <h3>{product.name}</h3>
                  <p>{product.summary}</p>
                  <span class="home-tool-action">View {product.name} <Icon name="arrow-up-right" /></span>
                </div>
              </Link>
            </Card>
          ))}
        </RevealGroup>
      </section>

      <section id="packages" class="site-shell home-section" aria-labelledby="packages-title">
        <div class="home-package-layout">
          <div class="home-package-copy">
            <Eyebrow class="home-eyebrow"><span>03</span> / Make it your own</Eyebrow>
            <h2 id="packages-title">The foundation.<br />Your next idea.</h2>
            <p>Use the same colors, typography, and brand assets in your own interface. One shared package, from the first sketch to the final surface.</p>
            <ButtonLink class="home-button home-text-link" variant="unstyled" href="https://github.com/santi020k/santi020k-theme" newTab>Explore the source <Icon name="arrow-up-right" /></ButtonLink>
          </div>
          <Card as="article" variant="unstyled" class="home-package-code" aria-label="Package install and import examples">
            <div class="home-code-heading"><span>@santi020k/theme</span><span>CSS / JavaScript</span></div>
            <div class="home-code-block"><span>01 / Install</span><code>pnpm add @santi020k/theme</code></div>
            <div class="home-code-block"><span>02 / Set the palette</span><code>@import '@santi020k/theme/tokens.css';</code></div>
            <div class="home-code-block"><span>03 / Build on it</span><code>import &#123; config, projects &#125;<br />  from '@santi020k/theme'</code></div>
          </Card>
        </div>
      </section>

      <section id="assets" class="site-shell home-section home-assets" aria-labelledby="assets-title">
        <div class="home-section-heading">
          <div>
            <Eyebrow class="home-eyebrow"><span>04</span> / Beyond the window</Eyebrow>
            <h2 id="assets-title">A little violet.<br />A little more yours.</h2>
          </div>
          <p class="home-section-intro">Sculptural ceramic, deep violet satin, and sunlit dunes. Three favorites to bring a little of the palette to your desktop.</p>
        </div>
        <div class="home-wallpaper-grid">
          {featuredWallpapers.map((wallpaper, index) => (
            <Card as="article" variant="unstyled" class="home-wallpaper">
              <Link class="home-wallpaper-image" variant="inherit" href={wallpaper.download} download={wallpaper.filename} aria-label={`Download ${wallpaper.name} ${wallpaper.edition.toLowerCase()} desktop wallpaper`}>
                <Image src={wallpaper.image} alt={wallpaper.description} widths={[480, 800, 1200]} sizes="(max-width: 767px) 92vw, 30vw" loading="lazy" />
              </Link>
              <div class="home-wallpaper-heading"><span>{String(index + 1).padStart(2, '0')}</span><h3>{wallpaper.name}</h3><ButtonLink class="home-wallpaper-download" variant="unstyled" href={wallpaper.download} download={wallpaper.filename} aria-label={`Download ${wallpaper.name} ${wallpaper.edition.toLowerCase()} desktop wallpaper`}><Icon name="download" /></ButtonLink></div>
              <p>{wallpaper.collection} · {wallpaper.edition} desktop · 3840 × 2160 · WEBP</p>
            </Card>
          ))}
        </div>
        <div class="home-assets-footer"><p>Explore every collection, both light and dark editions, and phone compositions in the gallery.</p><ButtonLink class="home-button home-text-link" variant="unstyled" href="/gallery/">Browse all assets <Icon name="arrow-right" /></ButtonLink></div>
      </section>
    </main>

    <SharedFooter />

    <script>
      import '../main.js'
    </script>
    <UIPrimitives />
  </body>
</html>
