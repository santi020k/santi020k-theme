---
import { Image } from 'astro:assets'

import { Badge, ButtonLink, Card, Eyebrow, Icon, Link } from '@santi020k/lumen-astro'
import UIPrimitives from '@santi020k/lumen-astro/runtime'

import wallpaperOne from '../../../../packages/theme/assets/wallpapers/wallpaper-1-desktop.webp'
import wallpaperTwo from '../../../../packages/theme/assets/wallpapers/wallpaper-2-desktop.webp'
import wallpaperThree from '../../../../packages/theme/assets/wallpapers/wallpaper-3-desktop.webp'
import SharedFooter from '../components/SharedFooter.astro'
import SharedHeader from '../components/SharedHeader.astro'
import { products } from '../data/products.js'

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Santi020k Themes',
  url: 'https://theme.santi020k.com/',
  description: 'The hub for Santi020k visual themes across editors, terminals, browsers, launchers, and collaboration tools.',
  author: {
    '@type': 'Person',
    name: 'Santiago Molina',
    url: 'https://santi020k.com',
    sameAs: ['https://github.com/santi020k', 'https://twitter.com/santi020k']
  },
  hasPart: [
    {
      '@type': 'SoftwareApplication',
      name: 'Santi020k Theme for VS Code',
      url: 'https://theme.santi020k.com/vscode/',
      applicationCategory: 'DeveloperApplication'
    },
    {
      '@type': 'SoftwareApplication',
      name: 'Santi020k Theme for Chrome',
      url: 'https://theme.santi020k.com/chrome/',
      applicationCategory: 'BrowserApplication'
    },
    {
      '@type': 'SoftwareApplication',
      name: 'Santi020k Theme for iTerm2',
      url: 'https://theme.santi020k.com/terminal/',
      applicationCategory: 'DeveloperApplication'
    },
    {
      '@type': 'SoftwareApplication',
      name: 'Santi020k Theme for Zed',
      url: 'https://theme.santi020k.com/zed/',
      applicationCategory: 'DeveloperApplication'
    },
    {
      '@type': 'SoftwareApplication',
      name: 'Santi020k Theme for Codex',
      url: 'https://theme.santi020k.com/codex/',
      applicationCategory: 'DeveloperApplication'
    },
    ...products.slice(5).map(product => ({
      '@type': 'SoftwareApplication',
      name: `Santi020k Theme for ${product.name}`,
      url: `https://theme.santi020k.com/${product.slug}/`,
      applicationCategory: 'DeveloperApplication'
    })),
    {
      '@type': 'SoftwareSourceCode',
      name: '@santi020k/theme',
      url: 'https://github.com/santi020k/santi020k-theme',
      codeRepository: 'https://github.com/santi020k/santi020k-theme',
      programmingLanguage: ['CSS', 'JavaScript', 'TypeScript']
    }
  ]
}

const structuredDataJson = JSON.stringify(structuredData).replace(/</g, '\\u003c')
---

<!doctype html>
<html lang="en" data-santi020k-site="hub">
  <head>
    <meta charset="UTF-8" />
    <script>
  (function () {
    var s = localStorage.getItem('theme')
    var pref = s

    if (pref !== 'light' && pref !== 'dark') {
      pref = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark'
    }

    document.documentElement.setAttribute('data-theme', pref)
  })()
  </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Santi020k Themes — One violet system across your tools</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@300..700&family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link rel="preload" as="image" href="/hub-hero-art.png" fetchpriority="high" />
    <meta name="description" content="The Santi020k theme family hub: coordinated themes for editors, terminals, browsers, launchers, and collaboration tools." />
    <meta name="author" content="Santiago Molina" />
    <meta name="language" content="en" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="color-scheme" content="dark light" />
    <link rel="canonical" href="https://theme.santi020k.com/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#110c1d" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f8f6fd" media="(prefers-color-scheme: light)" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://theme.santi020k.com/" />
    <meta property="og:site_name" content="Santi020k Themes" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content="Santi020k Themes — One violet system across your tools" />
    <meta property="og:description" content="A coordinated theme family for editors, terminals, browsers, launchers, and collaboration tools." />
    <meta property="og:image" content="https://theme.santi020k.com/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Santi020k Themes hub" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@santi020k" />
    <meta name="twitter:creator" content="@santi020k" />
    <meta name="twitter:url" content="https://theme.santi020k.com/" />
    <meta name="twitter:title" content="Santi020k Themes" />
    <meta name="twitter:description" content="A coordinated theme family for editors, terminals, browsers, launchers, and collaboration tools." />
    <meta name="twitter:image" content="https://theme.santi020k.com/og-image.png" />
    <meta name="twitter:image:alt" content="The Santi020k theme family across editors, browsers, terminals, and developer tools" />
    <script is:inline type="application/ld+json" set:html={structuredDataJson}></script>
  </head>
  <body>
    <SharedHeader />

    <main id="top">
      <section class="site-shell hero">
        <div class="hero-copy">
          <Eyebrow class="eyebrow">Theme family</Eyebrow>
          <h1>Santi020k Themes</h1>
          <p class="lede">
            Calm contrast and one violet color language across the tools you use every day.
          </p>
          <div class="actions" aria-label="Primary theme links">
            <ButtonLink class="button button-primary" variant="primary" href="#themes">Browse all themes</ButtonLink>
            <ButtonLink class="button button-secondary" variant="secondary" href="/gallery/">Open the gallery</ButtonLink>
            <ButtonLink class="button button-secondary" variant="secondary" href="https://github.com/santi020k/santi020k-theme" newTab>View on GitHub</ButtonLink>
          </div>
        </div>

        <div class="hero-art" aria-label="Theme previews">
          <Image src="/hub-hero-art.png" width="1536" height="1024" alt="Abstract editor and browser windows using the Santi020k theme palette" fetchpriority="high" inferSize />
          <div class="hero-art-caption" aria-hidden="true">
            <span>VS Code</span>
            <span>Chrome</span>
            <span>Zed</span>
            <span>Codex</span>
          </div>
        </div>
      </section>

      <section id="themes" class="site-shell section">
        <div class="section-heading">
          <div>
            <Eyebrow class="eyebrow">Nine themes. One system.</Eyebrow>
            <p class="section-intro">Every port ships from the same purple-forward foundation, with install guidance and platform-specific coverage.</p>
          </div>
          <h2>Choose your surface.</h2>
        </div>

        <div class="theme-grid">
          {products.map((product, index) => (
            <Card as="article" class="theme-card" data-product={product.slug}>
              <Link class="theme-card-preview" href={`/${product.slug}/`} aria-label={`View the ${product.name} theme`}>
                <div class="theme-card-window" aria-hidden="true">
                  <div class="theme-card-toolbar"><span><i></i><i></i><i></i></span><b>{product.name}</b><small>{String(index + 1).padStart(2, '0')}</small></div>
                  <div class="theme-card-canvas"><span class="theme-card-rail"><i></i><i></i><i></i><i></i></span><span class="theme-card-lines"><i></i><i></i><i></i><i></i><i></i></span></div>
                </div>
              </Link>
              <div class="theme-card-body">
                <div class="theme-card-meta"><Badge class="card-kicker" variant="success"><span class="status-dot" aria-hidden="true"></span>Available</Badge><span>{product.category}</span></div>
                <h3><Link href={`/${product.slug}/`}>{product.name}</Link></h3>
                <p>{product.summary}</p>
                <ButtonLink class="button button-secondary theme-card-action" variant="secondary" href={`/${product.slug}/`}>View {product.name} theme</ButtonLink>
              </div>
            </Card>
          ))}
        </div>
      </section>

      <section id="packages" class="site-shell section packages-section">
        <div class="section-heading">
          <Eyebrow class="eyebrow">npm package</Eyebrow>
          <h2>Use the same tokens in your own surface.</h2>
        </div>

        <Card as="article" class="package-panel">
          <div class="package-copy">
            <Badge class="card-kicker" variant="success">
              <span class="status-dot" aria-hidden="true"></span>
              Live on npm
            </Badge>
            <h3>@santi020k/theme</h3>
            <p>Design tokens, CSS custom properties, Tailwind mappings, and shared brand assets for Santi020k websites, apps, and theme-family surfaces.</p>
            <div class="card-actions">
              <ButtonLink class="button button-primary" variant="primary" href="https://github.com/santi020k/santi020k-theme" rel="noopener noreferrer">View source</ButtonLink>
            </div>
          </div>

          <div class="package-snippet" aria-label="Package install and import examples">
            <code>pnpm add @santi020k/theme</code>
            <code>@import '@santi020k/theme/tokens.css';</code>
            <code>import &#123; config, projects &#125; from '@santi020k/theme'</code>
          </div>
        </Card>
      </section>

      <section id="assets" class="site-shell section assets-section">
        <div class="section-heading assets-heading">
          <div class="assets-heading-copy">
            <Eyebrow class="eyebrow">Wallpapers</Eyebrow>
            <h2>Bring the palette to your desktop.</h2>
            <p>Three production-ready backgrounds, available directly from the shared theme asset package.</p>
          </div>
        </div>
        <div class="wallpaper-grid">
          {[wallpaperOne, wallpaperTwo, wallpaperThree].map((wallpaper, index) => (
            <Card as="article" class="wallpaper-card">
              <div class="wallpaper-card-media">
                <Image src={wallpaper} alt={`Santi020k violet horizon wallpaper ${index + 1}`} loading="lazy" />
                <span aria-hidden="true">0{index + 1}</span>
              </div>
              <div class="wallpaper-card-body">
                <div>
                  <p>3840 × 2160 · WEBP</p>
                  <h3>Violet horizon {String(index + 1).padStart(2, '0')}</h3>
                </div>
                <ButtonLink class="button button-primary" variant="primary" href={wallpaper.src} download={`santi020k-wallpaper-${index + 1}.webp`}>Download <Icon name="download" /></ButtonLink>
              </div>
            </Card>
          ))}
        </div>
        <div class="section-cta">
          <p>Need another size or format? The complete library includes mobile wallpapers, banners, editor previews, and brand marks.</p>
          <ButtonLink class="button button-secondary" variant="secondary" href="/gallery/">Browse all assets <Icon name="arrow-right" /></ButtonLink>
        </div>
      </section>
    </main>

    <SharedFooter />

    <script>
      import '../main.js'
    </script>
    <UIPrimitives />
  </body>
</html>
