---
import { Image } from 'astro:assets'

import { BackToTop, Button, ButtonLink, Card, Dialog, Eyebrow, Icon, Link } from '@santi020k/lumen-astro'
import UIPrimitives from '@santi020k/lumen-astro/runtime'

import SharedFooter from '../components/SharedFooter.astro'
import SharedHeader from '../components/SharedHeader.astro'
import { galleryAssets as assets } from '../data/gallery-assets.js'

const canonical = 'https://theme.santi020k.com/gallery/'
const title = 'Gallery & Downloads — Santi020k Theme'
const description = 'Download Santi020k Theme wallpapers, banners, VS Code previews, and brand assets in their original resolution.'
const socialImage = 'https://theme.santi020k.com/og-image.png'
const imageAlt = 'Santi020k Theme gallery with wallpapers, banners, editor previews, and brand assets'
const categories = ['wallpapers', 'banners', 'previews', 'logos']

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description,
  url: canonical,
  isPartOf: {
    '@type': 'WebSite',
    name: 'Santi020k Themes',
    url: 'https://theme.santi020k.com/'
  }
}

const structuredDataJson = JSON.stringify(structuredData).replace(/</g, '\\u003c')
---

<!doctype html>
<html lang="en" data-santi020k-site="hub">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      (function () {
        var saved = localStorage.getItem('theme')
        var preferred = saved

        if (preferred !== 'light' && preferred !== 'dark') {
          preferred = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark'
        }

        document.documentElement.setAttribute('data-theme', preferred)
      })()
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Santiago Molina" />
    <meta name="language" content="en" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="color-scheme" content="dark light" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@300..700&family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet" />
    <meta name="theme-color" content="#110c1d" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f8f6fd" media="(prefers-color-scheme: light)" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Santi020k Themes" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Wallpapers, banners, previews, and brand assets in one calm violet collection." />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@santi020k" />
    <meta name="twitter:creator" content="@santi020k" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content="Wallpapers, banners, previews, and brand assets in one calm violet collection." />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <script is:inline type="application/ld+json" set:html={structuredDataJson}></script>
  </head>
  <body>
    <SharedHeader />

    <main id="top">
      <section class="site-shell gallery-hero" aria-labelledby="gallery-hero-title">
        <div class="gallery-hero-copy">
          <Eyebrow class="eyebrow">Gallery & downloads</Eyebrow>
          <h1 id="gallery-hero-title">The Santi020k asset library.</h1>
          <p class="lede">Wallpapers, social banners, editor previews, and brand marks—organized by collection and ready in the format you need.</p>
          <div class="collection-downloads" aria-label="Collection downloads">
            <ButtonLink class="button button-primary" variant="primary" href="#asset-library">Browse all assets</ButtonLink>
            <ButtonLink class="button button-secondary" variant="secondary" href="/downloads/santi020k-wallpapers.zip" download>Wallpapers ZIP</ButtonLink>
            <ButtonLink class="button button-secondary" variant="secondary" href="/downloads/santi020k-banners.zip" download>Banners ZIP</ButtonLink>
          </div>
        </div>
        <aside class="gallery-hero-index" aria-label="Gallery summary">
          <Eyebrow class="gallery-index-label">Available now</Eyebrow>
          <dl>
            <div><dt>{assets.length}</dt><dd>assets</dd></div>
            <div><dt>4</dt><dd>collections</dd></div>
            <div><dt>4</dt><dd>file formats</dd></div>
          </dl>
          <p>PNG · WEBP · SVG · HEIC</p>
        </aside>
      </section>

      <section id="asset-library" class="site-shell gallery-section" aria-labelledby="gallery-heading">
        <div class="gallery-toolbar">
          <div class="gallery-toolbar-copy"><Eyebrow class="eyebrow">Asset library</Eyebrow><h2 id="gallery-heading">Choose a collection.</h2><p>Preview each asset at full size, then download only the format you need.</p></div>
          <div class="gallery-controls">
            <div class="filter-group" role="group" aria-label="Filter assets">
              {['all', ...categories].map((filter, index) => <Button class="filter-button" type="button" data-filter={filter} aria-pressed={index === 0 ? 'true' : 'false'}><span>{filter === 'all' ? 'All assets' : filter}</span><span class="filter-count" aria-hidden="true">{filter === 'all' ? assets.length : assets.filter(asset => asset.category === filter).length}</span></Button>)}
            </div>
            <p class="gallery-count" aria-live="polite"><strong data-gallery-count>{assets.length}</strong> <span data-gallery-count-label>assets shown</span></p>
          </div>
        </div>
        <div class="asset-grid">
          {assets.map(asset => (
            <Card as="article" class:list={['asset-card', { 'asset-card-portrait': 'portrait' in asset && asset.portrait }]} data-category={asset.category}>
              <Button class:list={['asset-preview', { 'asset-preview-contain': ('contain' in asset && asset.contain) || ('portrait' in asset && asset.portrait) }]} type="button" data-preview-src={asset.preview.src} data-preview-alt={`${asset.title}, ${asset.variant}`} data-preview-title={`${asset.title} — ${asset.variant}`} aria-label={`Preview ${asset.title}, ${asset.variant}`}>
                <Image src={asset.preview} alt="" loading="lazy" />
                <span class="preview-label">Open preview</span>
              </Button>
              <div class="asset-card-body">
                <div><p class="asset-category"><span>{asset.category}</span><span>{asset.variant}</span></p><h3>{asset.title}</h3><p class="asset-meta">{asset.dimensions}</p></div>
                <div class="asset-formats" aria-label={`Download ${asset.title} formats`}>
                  {asset.formats.map(format => <Link href={format.href} download={format.file} title={`Download ${asset.title} as ${format.label}`}>{format.label}<Icon name="download" class="asset-format-icon" /></Link>)}
                </div>
              </div>
            </Card>
          ))}
        </div>
        <p class="gallery-empty" hidden>No assets match this filter.</p>
      </section>
    </main>

    <Dialog class="asset-dialog" aria-labelledby="asset-dialog-title">
      <div class="dialog-header"><div><Eyebrow class="eyebrow">Full preview</Eyebrow><h2 id="asset-dialog-title"></h2></div><Button class="dialog-close" type="button" aria-label="Close preview"><Icon name="x" /></Button></div>
      <div class="dialog-media"><img alt="" /></div>
    </Dialog>

    <BackToTop class="back-to-top" aria-label="Back to top"><Icon name="chevron-up" /></BackToTop>

    <SharedFooter />
    <script>import '../main.js'
</script>
    <UIPrimitives />
  </body>
</html>
