---
import { ButtonLink, Icon, Particles, ScrollReveal } from '@santi020k/lumen-astro'

import ProductLayout from '../layouts/ProductLayout.astro'

const palette = [
  { name: 'Canvas', token: '--theme-bg', description: 'The quiet base behind every page.' },
  { name: 'Surface', token: '--site-surface', description: 'One solid surface for a content group.' },
  { name: 'Soft surface', token: '--site-surface-muted', description: 'A subtle change of rhythm.' },
  { name: 'Ink', token: '--site-ink', description: 'Headings and strong controls.' },
  { name: 'Soft ink', token: '--site-ink-soft', description: 'Reading copy and useful metadata.' },
  { name: 'Line', token: '--site-line', description: 'Fine structure, without heavy frames.' },
  { name: 'Violet', token: '--site-brand', description: 'Our identity and interaction accent.' },
  { name: 'Accent', token: '--site-accent', description: 'Visible focus and small highlights.' }
]

const rhythm = [
  { label: 'Grid gap', value: '1.5rem', token: '--site-grid-gap' },
  { label: 'Heading gap', value: '2.5rem', token: '--site-heading-gap' },
  { label: 'Section space', value: '7rem / 4.5rem', token: '--site-section-space' }
]
---
<ProductLayout pageKind="guide" name="Visual guide" slug="design" title="Sculpted visual guide — Santi020k Theme" description="Explore the typography, violet palette, controls, surfaces, and spacing shared by Santi020k themes and documentation.">
  <div class="design-guide site-shell">
    <header class="guide-hero">
      <Particles class="guide-signature" density="low" />
      <p class="guide-eyebrow">The Sculpted collection / Visual guide</p>
      <h1>Quiet by design.<br /><span>Precise in every detail.</span></h1>
      <p class="guide-intro">A shared visual line for the tools we use every day. Open space, thoughtful typography, and a little violet. The same language as the new santi020k website.</p>
      <div class="guide-actions">
        <ButtonLink variant="unstyled" class="guide-primary" href="#typography">Explore the guide <span aria-hidden="true"><Icon name="arrow-down" /></span></ButtonLink>
        <ButtonLink variant="unstyled" class="guide-secondary" href="/terminal/docs/">Read the documentation <Icon name="arrow-right" /></ButtonLink>
      </div>
      <p class="guide-appearance">Use the appearance switch in the navigation to explore every example in light and dark.</p>
    </header>
    <ScrollReveal as="section" animation="fade" duration="standard" id="typography" class="guide-section" aria-labelledby="typography-title">
      <div class="guide-section-heading"><p class="guide-eyebrow">01 / Typography</p><h2 id="typography-title">Let the words carry it.</h2><p>Locally served Montserrat. Medium-weight headings, generous leading, and complete titles.</p></div>
      <div class="type-specimens">
        <div><span>Display / 600 / up to 5.5rem</span><p class="type-display">Made for focus.</p></div>
        <div><span>Section / 500 / 2.25–3.75rem</span><p class="type-heading">A calmer workspace.</p></div>
        <div><span>Body / 400 / 0.9375rem / 1.85</span><p class="type-body">Good design makes room for the important things. Keep the reading canvas quiet, make the next action clear, and let real product previews tell the story.</p></div>
      </div>
    </ScrollReveal>
    <ScrollReveal as="section" animation="fade" duration="standard" class="guide-section" aria-labelledby="palette-title">
      <div class="guide-section-heading"><p class="guide-eyebrow">02 / Palette</p><h2 id="palette-title">One violet language.</h2><p>These are live shared tokens. Change the page appearance and the entire palette follows.</p></div>
      <div class="guide-palette">{palette.map(color => <article class="palette-item"><div class="palette-color" style={`background: var(${color.token})`} aria-hidden="true"></div><h3>{color.name}</h3><code>{color.token}</code><p>{color.description}</p></article>)}</div>
    </ScrollReveal>
    <ScrollReveal as="section" animation="fade" duration="standard" class="guide-section" aria-labelledby="controls-title">
      <div class="guide-section-heading"><p class="guide-eyebrow">03 / Controls</p><h2 id="controls-title">Clear next steps.</h2><p>Solid primary actions, quiet secondary links, and 44px minimum targets. Try navigating these examples with the keyboard.</p></div>
      <div class="control-examples"><ButtonLink variant="unstyled" class="guide-primary" href="/#themes">Browse themes <span aria-hidden="true"><Icon name="arrow-right" /></span></ButtonLink><ButtonLink variant="unstyled" class="guide-secondary" href="/gallery/">Explore wallpapers <Icon name="arrow-right" /></ButtonLink></div>
    </ScrollReveal>
    <ScrollReveal as="section" animation="fade" duration="standard" class="guide-section" aria-labelledby="surfaces-title">
      <div class="guide-section-heading"><p class="guide-eyebrow">04 / Surfaces</p><h2 id="surfaces-title">Structure with restraint.</h2><p>One surface per group. Fine rules and open rows do the rest.</p></div>
      <div class="surface-examples"><article class="surface-example"><p class="guide-eyebrow">Solid surface</p><h3>Room to breathe.</h3><p>A 1.5rem radius and generous padding create a calm content group. Depth belongs to artwork and navigation.</p></article><article class="surface-example surface-example-muted"><p class="guide-eyebrow">Quiet grouping</p><h3>Same family. Softer rhythm.</h3><p>Use a semantic surface change for related content. Keep essential text readable in both appearances.</p></article></div>
    </ScrollReveal>
    <ScrollReveal as="section" animation="fade" duration="standard" class="guide-section" aria-labelledby="spacing-title">
      <div class="guide-section-heading"><p class="guide-eyebrow">05 / Rhythm</p><h2 id="spacing-title">Space is part of the system.</h2><p>One 72rem alignment, with a rhythm that naturally contracts on smaller screens.</p></div>
      <dl class="rhythm-list">{rhythm.map(space => <div><dt>{space.label}</dt><dd><span class="rhythm-bar" style={`width: var(${space.token})`} aria-hidden="true"></span><span>{space.value}</span><code>{space.token}</code></dd></div>)}</dl>
      <p class="guide-appearance">Hover transitions stay subtle. Reduced-motion preferences remove decorative motion and smooth scrolling.</p>
    </ScrollReveal>
  </div>
</ProductLayout>
<style>
  .design-guide { padding-block: 5rem 1rem; }
  .guide-hero { position: relative; isolation: isolate; max-width: 58rem; padding-block: 2rem var(--site-section-space); }
  .guide-eyebrow { color: var(--site-brand); font-size: .625rem; font-weight: 600; letter-spacing: .13em; text-transform: uppercase; margin: 0 0 1.5rem; }
  .guide-hero h1 { max-width: none; margin: 0 0 2rem; font-size: var(--site-page-title-size); line-height: 1.02; font-weight: 600; letter-spacing: -.065em; }
  .guide-hero h1 span { color: var(--site-brand); }
  .guide-intro { max-width: 38rem; font-size: var(--site-body-size); line-height: var(--site-body-line-height); color: var(--site-ink-soft); }
  .guide-actions, .control-examples { display: flex; gap: 1.5rem; flex-wrap: wrap; align-items: center; margin-top: 2rem; }
  .guide-primary { display: inline-flex; gap: 1.5rem; align-items: center; min-height: 52px; padding: .5rem .5rem .5rem 1.25rem; border-radius: var(--site-control-radius); background: var(--site-ink); color: var(--theme-bg); font-size: .8125rem; font-weight: 500; }
  .guide-primary span { display: grid; place-items: center; width: 36px; height: 36px; border-radius: var(--site-arrow-radius); background: var(--theme-bg); color: var(--site-ink); }
  .guide-secondary { display: inline-flex; min-height: var(--site-control-min-height); align-items: center; gap: .75rem; font-size: .8125rem; font-weight: 500; }
  .guide-primary, .guide-secondary { transition: opacity .2s; }
  .guide-primary:hover, .guide-secondary:hover { opacity: .8; }
  .design-guide a:focus-visible { outline: 2px solid var(--site-accent); outline-offset: 4px; }
  .guide-appearance { margin-top: 1.5rem; color: var(--site-ink-soft); font-size: .75rem; line-height: 1.75; }
  .guide-section { padding-block: var(--site-section-space); border-top: 1px solid var(--section-divider); scroll-margin-top: 9rem; }
  .guide-section-heading { max-width: 46rem; margin-bottom: var(--site-heading-gap); }
  .guide-section h2 { max-width: none; margin: 0 0 1.25rem; font-size: var(--site-section-title-size); line-height: var(--site-section-title-line-height); font-weight: 500; letter-spacing: var(--site-title-tracking); }
  .guide-section-heading > p:last-child { max-width: 36rem; color: var(--site-ink-soft); font-size: var(--site-body-size); line-height: var(--site-body-line-height); }
  .type-specimens > div { padding-block: 2rem; border-bottom: 1px solid var(--section-divider); }
  .type-specimens span { font-size: .6875rem; color: var(--site-ink-soft); }
  .type-specimens p { margin: 1.5rem 0 0; }
  .type-display { font-size: clamp(2.5rem, 7vw, 5.5rem); font-weight: 600; line-height: 1.02; letter-spacing: -.065em; }
  .type-heading { font-size: var(--site-section-title-size); font-weight: 500; line-height: 1.08; letter-spacing: -.065em; }
  .type-body { max-width: 36rem; font-size: var(--site-body-size); line-height: var(--site-body-line-height); color: var(--site-ink-soft); }
  .guide-palette { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--site-grid-gap); }
  .palette-color { height: 8rem; border: 1px solid var(--site-line); border-radius: var(--site-card-radius); }
  .palette-item h3 { margin: 1.25rem 0 .5rem; font-size: 1rem; font-weight: 500; }
  .palette-item code, .rhythm-list code { font-size: .6875rem; overflow-wrap: anywhere; color: var(--site-ink-soft); }
  .palette-item p { color: var(--site-ink-soft); font-size: .8125rem; line-height: 1.8; }
  .surface-examples { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--site-grid-gap); }
  .surface-example { padding: clamp(1.5rem, 4vw, 3rem); border-radius: var(--site-card-radius); background: var(--site-surface); }
  .surface-example-muted { background: var(--site-surface-muted); }
  .surface-example h3 { font-size: 1.75rem; line-height: 1.2; letter-spacing: -.055em; font-weight: 500; }
  .surface-example > p:last-child { margin-bottom: 0; font-size: var(--site-body-size); line-height: var(--site-body-line-height); color: var(--site-ink-soft); }
  .rhythm-list > div { display: grid; grid-template-columns: 12rem 1fr; padding: 1.5rem 0; gap: 1.5rem; border-bottom: 1px solid var(--section-divider); }
  .rhythm-list dt { font-size: .875rem; font-weight: 500; }
  .rhythm-list dd { display: flex; gap: 1.5rem; align-items: center; flex-wrap: wrap; margin: 0; font-size: .8125rem; }
  .rhythm-bar { height: .5rem; border-radius: 1rem; background: var(--site-brand); }
  @media (max-width: 767px) { .design-guide { padding-top: 2rem; } .guide-palette { grid-template-columns: repeat(2, minmax(0, 1fr)); } .surface-examples { grid-template-columns: 1fr; } .rhythm-list > div { grid-template-columns: 1fr; gap: 1rem; } }
  @media (prefers-reduced-motion: reduce) { .guide-primary, .guide-secondary { transition: none; } }
  .guide-hero > :not(:global(.guide-signature)) { position: relative; z-index: 1; }
  :global(.guide-signature.ui-particles) { position: absolute; inset: 0; min-height: 0; pointer-events: none; opacity: .25; background: none; border: 0; border-radius: 0; z-index: 0; }
  @media (prefers-reduced-motion: reduce) { :global(.guide-signature) { display: none; } }
</style>
