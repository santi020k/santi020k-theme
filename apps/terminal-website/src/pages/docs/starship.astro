---
import { Callout, Card, Code, CodeTabs, Link } from '@santi020k/lumen-astro'

import { promptVariants, starshipFilename } from '../../../../../packages/santi020k-terminal-theme/prompt-presets.mjs'
import DocsLayout from '../../layouts/DocsLayout.astro'

const base = 'https://theme.santi020k.com/terminal/starship'
const install = 'brew install starship'
const init = 'eval "$(starship init zsh)"'

const paletteCommands = ['dark', 'light'].map(palette => ({
  value: palette,
  label: palette === 'dark' ? 'Dark palette' : 'Light palette',
  language: 'sh',
  code: `mkdir -p ~/.config\ncurl --proto '=https' --tlsv1.2 -fsSL ${base}/santi020k-${palette}.toml -o ~/.config/starship.toml`
}))

const headings = [{ id: 'presets', label: 'Prompt presets' }, { id: 'prompt-only', label: 'Prompt-only install' }, { id: 'font', label: 'Font requirement' }]
const variants = Object.entries(promptVariants).map(([key, variant]) => ({ ...variant, dark: `/terminal/starship/${starshipFilename('dark', key)}`, light: `/terminal/starship/${starshipFilename('light', key)}` }))
---
<DocsLayout title="Starship prompt" description="Use a quiet Powerline prompt with coordinated dark and light violet palettes." path="/terminal/docs/starship/" {headings}>
  <section id="presets"><h2>Three prompts, one palette</h2><p>Rich is the full prompt. Portable replaces application icons with labels. Minimal removes runtime modules for a quieter prompt.</p><div class="docs-card-grid compact">{variants.map(variant => <Card as="article"><h3>{variant.name}</h3><p>{variant.description}</p><div class="docs-downloads"><Link href={variant.dark} download>Dark</Link><Link href={variant.light} download>Light</Link></div></Card>)}</div></section>
  <section id="prompt-only"><h2>Install only the prompt</h2><ol><li><p>Install Starship:</p><Code variant="block" code={install} language="sh" label="Install Starship" copy copyLabel="Copy Starship installation command" theme="santi020k" /></li><li><p>Enable it in the current Zsh session:</p><Code variant="block" code={init} language="sh" label="Enable Starship" copy copyLabel="Copy Starship initialization command" theme="santi020k" /></li><li><p>Back up <code>~/.config/starship.toml</code>, then download the preset you want. For example:</p><CodeTabs items={paletteCommands} ariaLabel="Starship palette download commands" codeLabel="Download Starship palette" copyLabel="Copy selected palette download command" storageKey="santi020k-docs-palette" theme="santi020k" wrap={false} /></li></ol><Callout className="docs-callout"><b>Using Oh My Zsh?</b><p>Set <code>ZSH_THEME=""</code> before Oh My Zsh loads. Your plugins can remain enabled while Starship owns the prompt.</p></Callout></section>
  <section id="font"><h2>Install a Nerd Font</h2><p>The Powerline separators and symbols require a Nerd Font. The site preview uses CaskaydiaCove Nerd Font at 15 pt with approximately 110% vertical spacing.</p><Code variant="block" code="brew install --cask font-caskaydia-cove-nerd-font" language="sh" label="Install the preview font" copy copyLabel="Copy Nerd Font installation command" theme="santi020k" /></section>
</DocsLayout>
