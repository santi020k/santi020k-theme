---
import { Button, Checkbox, Field, Label, RadioGroup, Select } from '@santi020k/lumen-astro'

import TerminalPreview from '../components/TerminalPreview.astro'
import SiteLayout from '../layouts/SiteLayout.astro'

const canonical = 'https://theme.santi020k.com/terminal/configure/'
const description = 'Choose a shell, terminal palette, prompt density, and runtime modules, then copy one setup command.'
const schema = { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'Santi020k Terminal configurator', url: canonical, description, applicationCategory: 'DeveloperApplication' }
---
<SiteLayout title="Configure Santi020k Terminal" {description} {canonical} {schema}>
  <section class="shell configurator-page" data-configurator>
    <header class="configurator-heading"><p class="eyebrow">Live configurator</p><h1>Build your terminal setup.</h1><p class="lede">Adjust the managed shell, terminal colors, prompt style, and visible runtime modules. The preview and command update together.</p></header>
    <div class="configurator-layout">
      <form class="configurator-controls" aria-label="Terminal configuration">
        <RadioGroup><legend>Shell</legend><label><input type="radio" name="shell" value="zsh" checked /> Zsh</label><label><input type="radio" name="shell" value="bash" /> Bash</label><label><input type="radio" name="shell" value="fish" /> Fish</label><label><input type="radio" name="shell" value="all" /> All</label></RadioGroup>
        <RadioGroup><legend>Prompt</legend><label><input type="radio" name="prompt" value="rich" checked /> Rich icons</label><label><input type="radio" name="prompt" value="portable" /> Portable labels</label><label><input type="radio" name="prompt" value="minimal" /> Minimal</label></RadioGroup>
        <div class="configurator-row"><Field><Label for="configure-terminal">Terminal</Label><Select id="configure-terminal" name="terminal" value="skip" options={[{ value: 'skip', label: 'Skip colors' }, { value: 'iterm2', label: 'iTerm2' }, { value: 'ghostty', label: 'Ghostty' }, { value: 'kitty', label: 'Kitty' }, { value: 'wezterm', label: 'WezTerm' }, { value: 'alacritty', label: 'Alacritty' }, { value: 'windows-terminal', label: 'Windows Terminal' }]} /></Field><Field><Label for="configure-palette">Palette</Label><Select id="configure-palette" name="palette" value="dark" options={[{ value: 'dark', label: 'Dark' }, { value: 'light', label: 'Light' }]} /></Field></div>
        <fieldset><legend>Runtime modules</legend><label><Checkbox name="module" value="nodejs" checked /> Node.js</label><label><Checkbox name="module" value="python" checked /> Python</label><label><Checkbox name="module" value="rust" /> Rust</label><label><Checkbox name="module" value="golang" /> Go</label><label><Checkbox name="module" value="docker_context" checked /> Docker</label></fieldset>
      </form>
      <div class="configurator-result" aria-live="polite">
        <TerminalPreview prompt id="configurator-preview" />
        <h2>Your setup command</h2><p>Install the formula first, then run:</p><div class="command"><code data-config-command>santi020k-terminal configure zsh rich skip dark</code><Button variant="ghost" data-copy-dynamic aria-label="Copy generated setup command">Copy</Button></div>
        <div data-custom-command hidden><h3>Optional custom prompt</h3><div class="command"><code data-prompt-command></code><Button variant="ghost" data-copy-dynamic aria-label="Copy custom prompt command">Copy</Button></div></div>
        <p class="configurator-note">The CLI backs up managed files. Use <code>colors install … --dry-run</code> to inspect a color installation before writing it.</p>
      </div>
    </div>
  </section>
</SiteLayout>
