---
import { Breadcrumb, Link, Pagination, ScrollProgress } from '@santi020k/lumen-astro'

import { docsItems, docsSections } from '../data/docs.js'

import SiteLayout from './SiteLayout.astro'

interface Heading {
  id: string
  label: string
}

interface Props {
  title: string
  description: string
  path: string
  eyebrow?: string
  headings?: Heading[]
}

const { title, description, path, eyebrow = 'Documentation', headings = [] }: Props = Astro.props
const canonical = new URL(path, 'https://theme.santi020k.com').href
const schema = { '@context': 'https://schema.org', '@type': 'TechArticle', headline: title, description, url: canonical }
const currentIndex = docsItems.findIndex(item => item.href === path)
const previous = currentIndex > 0 ? docsItems[currentIndex - 1] : undefined
const next = currentIndex >= 0 ? docsItems[currentIndex + 1] : undefined
---
<SiteLayout title={`${title} — Santi020k Terminal docs`} {description} {canonical} {schema}>
  <ScrollProgress aria-label="Documentation reading progress" />
  <div class="docs-shell shell">
    <nav class="docs-sidebar" aria-label="Documentation navigation">
      <Link className="docs-home" href="/terminal/docs/">Terminal documentation</Link>
      {docsSections.map(section => (
        <div class="docs-nav-group">
          <span>{section.label}</span>
          {section.items.map(item => <Link href={item.href} aria-current={item.href === path ? 'page' : undefined}>{item.label}</Link>)}
        </div>
      ))}
    </nav>
    <article class="docs-article">
      <Breadcrumb className="docs-breadcrumb">
        <ol>
          <li><Link href="/">Theme family</Link></li>
          <li><Link href="/terminal/">Terminal</Link></li>
          {path !== '/terminal/docs/' && <li><Link href="/terminal/docs/">Documentation</Link></li>}
          <li aria-current="page">{title}</li>
        </ol>
      </Breadcrumb>
      <header class="docs-heading"><p class="eyebrow">{eyebrow}</p><h1>{title}</h1><p>{description}</p></header>
      <div class="docs-content"><slot /></div>
      <Pagination className="docs-pagination" aria-label="Documentation pagination">
        {previous ? <Link href={previous.href}><span>Previous</span><b>← {previous.label}</b></Link> : <span></span>}
        {next && <Link href={next.href}><span>Next</span><b>{next.label} →</b></Link>}
      </Pagination>
    </article>
    {headings.length > 0 && <aside class="docs-toc" aria-label="On this page"><b>On this page</b>{headings.map(heading => <Link href={`#${heading.id}`}>{heading.label}</Link>)}</aside>}
  </div>
</SiteLayout>

<style>
  .docs-breadcrumb { margin-bottom: 24px; }
  .docs-breadcrumb ol { display: flex; flex-wrap: wrap; gap: 8px; padding: 0; margin: 0; list-style: none; font-size: .8rem; color: var(--site-ink-soft); }
  .docs-breadcrumb li + li::before { content: '/'; margin-right: 8px; color: var(--site-ink-soft); }
  .docs-breadcrumb a { color: var(--site-brand); }
  .docs-article { min-width: 0; }
  .docs-content :global(.ui-code-tabs), .docs-content :global(.ui-code--block) { max-width: 100%; min-width: 0; margin-block: 22px; }
  .docs-content :global(.ui-code-tabs__list) { overflow-x: auto; }
</style>
