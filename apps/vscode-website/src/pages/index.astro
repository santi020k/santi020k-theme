---
import { Image } from 'astro:assets'

import { Button, ButtonLink, Card, Checkbox, Icon, Link, Select, Tabs, TabsList, TabsPanel, TabsTrigger } from '@santi020k/lumen-astro'
import UIPrimitives from '@santi020k/lumen-astro/runtime'

import previewBackdropDark from '../../../../artwork/vscode-gallery-v1/indigo-studio.png'
import previewBackdropLight from '../../../../artwork/vscode-gallery-v1/lavender-studio.png'
import previewDark from '../../../../packages/theme/assets/vscode/previews/preview-dark.png'
import previewHcDark from '../../../../packages/theme/assets/vscode/previews/preview-hc-dark.png'
import previewHcLight from '../../../../packages/theme/assets/vscode/previews/preview-hc-light.png'
import previewLight from '../../../../packages/theme/assets/vscode/previews/preview-light.png'
import PageTransitions from '../../../website/src/components/PageTransitions.astro'
import SharedFooter from '../../../website/src/components/SharedFooter.astro'
import SharedHeader from '../../../website/src/components/SharedHeader.astro'

const screenshots = [
  { image: previewDark, mode: 'dark', name: 'Dark', detail: 'Indigo depth. Muted violet syntax.', alt: 'santi020k dark theme in VS Code with the Explorer, editor tabs, and minimap' },
  { image: previewLight, mode: 'light', name: 'Light', detail: 'A lavender canvas with room to breathe.', alt: 'santi020k light theme in VS Code with purple syntax on a lavender canvas' },
  { image: previewHcDark, mode: 'hc', name: 'High contrast dark', detail: 'Near-black surfaces. Clearly defined edges.', alt: 'santi020k high contrast dark theme in VS Code with strong borders and vivid syntax accents' },
  { image: previewHcLight, mode: 'hclight', name: 'High contrast light', detail: 'A white canvas. Strong, readable structure.', alt: 'santi020k high contrast light theme in VS Code with clear syntax and dark borders' }
]

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Santi020k Theme',
  applicationCategory: 'DeveloperApplication',
  applicationSubCategory: 'Color Theme',
  operatingSystem: 'Windows, macOS, Linux',
  softwareVersion: '2.1.4',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  downloadUrl: 'https://marketplace.visualstudio.com/items?itemName=Santi020k.santi020k-theme',
  url: 'https://theme.santi020k.com/vscode/',
  description: 'A purple-forward VS Code color theme with dark, light, and high-contrast variants built around a deep indigo-black palette and muted violet accents.',
  screenshot: 'https://theme.santi020k.com/vscode/og-image.png',
  author: {
    '@type': 'Person',
    name: 'Santiago Molina',
    url: 'https://santi020k.com',
    sameAs: ['https://github.com/santi020k', 'https://twitter.com/santi020k']
  }
}

const structuredDataJson = JSON.stringify(structuredData).replace(/</g, '\\u003c')
---

<!doctype html>
<html lang="en">
  <head>
    <PageTransitions page="vscode" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Santi020k Theme — VS Code Color Theme</title>
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@300..700&display=swap" rel="stylesheet">
    <!-- Primary meta -->
    <meta name="description" content="A purple-forward VS Code color theme with dark, light, and high-contrast variants. Deep indigo-black depth, violet accents, and syntax colors built for long sessions. Free on the VS Code Marketplace." />
    <meta name="author" content="Santiago Molina" />
    <meta name="language" content="en" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="color-scheme" content="dark light" />
    <!-- Canonical -->
    <link rel="canonical" href="https://theme.santi020k.com/vscode/" />
    <!-- Icons -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Theme color — separate media queries so the browser chrome matches -->
    <meta name="theme-color" content="#110c1d" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f8f6fd" media="(prefers-color-scheme: light)" />
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://theme.santi020k.com/vscode/" />
    <meta property="og:site_name" content="Santi020k Theme" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content="Santi020k Theme — VS Code Color Theme" />
    <meta property="og:description" content="A purple-forward VS Code color theme with dark, light, and high-contrast variants. Deep indigo-black depth, violet accents, and syntax that stays expressive without shouting. Free." />
    <meta property="og:image" content="https://theme.santi020k.com/vscode/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Santi020k Theme — Dark, light, and high-contrast VS Code variants" />
    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@santi020k" />
    <meta name="twitter:creator" content="@santi020k" />
    <meta name="twitter:url" content="https://theme.santi020k.com/vscode/" />
    <meta name="twitter:title" content="Santi020k Theme — VS Code Color Theme" />
    <meta name="twitter:description" content="A purple-forward VS Code color theme with dark, light, and high-contrast variants. Free on the VS Code Marketplace." />
    <meta name="twitter:image" content="https://theme.santi020k.com/vscode/og-image.png" />
    <meta name="twitter:image:alt" content="Santi020k Theme - Dark, Light, and High Contrast" />
    <!-- JSON-LD: SoftwareApplication -->
    <script is:inline type="application/ld+json" set:html={structuredDataJson}></script>
  </head>
  <body>
    <SharedHeader currentProduct="vscode" productLinks={[{ href: '/vscode/', label: 'Overview' }, { href: '/vscode/#variants', label: 'Variants' }, { href: '/vscode/#screenshots', label: 'Preview' }, { href: '/vscode/#editors', label: 'Editors' }, { href: '/vscode/#settings', label: 'Settings' }, { href: '/vscode/#palette', label: 'Palette' }]} />

    <main id="top">
      <section class="site-shell hero">
        <div class="hero-copy">
          <p class="eyebrow">VS Code color theme</p>
          <h1>Calm editor surfaces. Clear purple focus.</h1>
          <p class="lede">
            Four color modes. Three syntax styles. A considered violet palette for your editor, terminal, and the work between them.
          </p>
          <div class="actions" aria-label="Theme actions">
            <ButtonLink class="button button-primary" variant="unstyled" href="https://marketplace.visualstudio.com/items?itemName=Santi020k.santi020k-theme" newTab>
              <span>VS Marketplace</span><span class="button-arrow"><Icon name="arrow-up-right" size="sm" decorative /></span>
            </ButtonLink>
            <ButtonLink class="button button-secondary" variant="unstyled" href="https://open-vsx.org/extension/santi020k/santi020k-theme" newTab>
              Open VSX
            </ButtonLink>
            <ButtonLink class="button button-secondary" variant="unstyled" href="https://vscode.dev/editor/theme/santi020k.santi020k-theme" newTab>
              Try in vscode.dev
            </ButtonLink>
            <ButtonLink class="button button-secondary" variant="unstyled" href="https://github.com/santi020k/santi020k-theme" newTab>
              GitHub
            </ButtonLink>
          </div>
          <div class="install-action">
            <Button class="button-copy-install" type="button" aria-label="Copy installation command">
              <span class="command">ext install santi020k.santi020k-theme</span>
              <span class="copy-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              </span>
            </Button>
          </div>
        </div>

        <div class="editor-preview" aria-label="Preview of the Santi020k Theme">
          <div class="preview-topbar">
            <div class="preview-dots">
              <span></span>
              <span></span>
              <span></span>
            </div>
            <strong class="preview-filename">santi020k-dark-color-theme.json</strong>
            <div class="preview-controls" role="group" aria-label="Preview settings">
              <div class="preview-control">
                <label class="preview-control-label" for="preview-lang">Language</label>
                <Select
                  id="preview-lang"
                  visualSize="sm"
                  class="preview-lang-select"
                  aria-label="Select preview language"
                  value="json"
                  options={[
                    { value: 'json', label: 'JSON' },
                    { value: 'ts', label: 'TypeScript' },
                    { value: 'js', label: 'JavaScript' },
                    { value: 'react', label: 'React' },
                    { value: 'rust', label: 'Rust' },
                    { value: 'go', label: 'Go' },
                    { value: 'prisma', label: 'Prisma' },
                    { value: 'java', label: 'Java' },
                    { value: 'cpp', label: 'C++' },
                    { value: 'elixir', label: 'Elixir' },
                    { value: 'tailwind', label: 'Tailwind CSS' }
                  ]}
                />
                <Icon class="preview-control-chevron" name="chevron-down" size="sm" decorative />
              </div>
              <div class="preview-appearance">
                <div class="preview-control">
                  <label class="preview-control-label" for="preview-theme">Theme</label>
                  <Select
                    id="preview-theme"
                    visualSize="sm"
                    class="preview-theme-select"
                    aria-label="Select preview theme"
                    value="dark"
                    options={[
                      { value: 'dark', label: 'Dark' },
                      { value: 'light', label: 'Light' },
                      { value: 'hc', label: 'HC Dark' },
                      { value: 'hclight', label: 'HC Light' }
                    ]}
                  />
                  <Icon class="preview-control-chevron" name="chevron-down" size="sm" decorative />
                </div>
                <div class="preview-control">
                  <label class="preview-control-label" for="preview-variant">Style</label>
                  <Select
                    id="preview-variant"
                    visualSize="sm"
                    class="preview-variant-select"
                    aria-label="Select preview style"
                    value="normal"
                    options={[
                      { value: 'normal', label: 'Normal' },
                      { value: 'bold', label: 'Bold' },
                      { value: 'italic', label: 'Italic' }
                    ]}
                  />
                  <Icon class="preview-control-chevron" name="chevron-down" size="sm" decorative />
                </div>
              </div>
            </div>
          </div>
          <div class="preview-body">
            <aside aria-hidden="true">
              <span class="active">01</span>
              <span>02</span>
              <span>03</span>
              <span>04</span>
              <span>05</span>
              <span>06</span>
              <span>07</span>
            </aside>
            <pre><code class="preview-code"></code></pre>
          </div>
        </div>
      </section>

      <section id="variants" class="site-shell section-grid">
        <div>
          <p class="eyebrow">Variants</p>
          <h2>Four modes. One visual rhythm.</h2>
        </div>
        <div class="variant-grid">
          <Card as="article" variant="unstyled" class="variant-card variant-dark">
            <p>Dark</p>
            <h3>Quiet depth.</h3>
            <span>#110c1d</span>
          </Card>
          <Card as="article" variant="unstyled" class="variant-card variant-light">
            <p>Light</p>
            <h3>Room to breathe.</h3>
            <span>#f8f6fd</span>
          </Card>
          <Card as="article" variant="unstyled" class="variant-card variant-hc">
            <p>HC Dark</p>
            <h3>Defined in the dark.</h3>
            <span>#0d0718</span>
          </Card>
          <Card as="article" variant="unstyled" class="variant-card variant-hc-light">
            <p>HC Light</p>
            <h3>Clarity in the light.</h3>
            <span>#ffffff</span>
          </Card>
        </div>
      </section>

      <section id="screenshots" class="site-shell screenshots-section">
        <div>
          <p class="eyebrow">Preview</p>
          <h2>The theme, in your editor.</h2>
          <p class="section-lede">Explore real VS Code captures in each color mode. Open any image to inspect the complete window at full resolution.</p>
        </div>
        <Tabs class="screenshot-showcase" initialValue="dark">
          <TabsList class="screenshot-modes" aria-label="Screenshot color mode">
            {screenshots.map(screenshot => (
              <TabsTrigger value={screenshot.mode}>{screenshot.name.replace('High contrast', 'HC')}</TabsTrigger>
            ))}
          </TabsList>
          {screenshots.map((screenshot, index) => (
            <TabsPanel value={screenshot.mode} class="screenshot-panel">
              <figure class="screenshot-card">
                <Link class="screenshot-stage" data-mode={screenshot.mode} href={screenshot.image.src} aria-label={`Open ${screenshot.name.toLowerCase()} VS Code screenshot at full size in a new tab`} newTab>
                  <Image class="screenshot-art" src={screenshot.mode === 'dark' || screenshot.mode === 'hc' ? previewBackdropDark : previewBackdropLight} alt="" aria-hidden="true" width="1200" format="webp" quality={80} sizes="(min-width: 1200px) 1152px, 100vw" loading="lazy" />
                  <Image class="screenshot-img" src={screenshot.image} alt={screenshot.alt} format="png" sizes="(min-width: 1200px) 1072px, 100vw" loading="lazy" />
                  <span class="screenshot-expand" aria-hidden="true"><Icon name="maximize-2" size="sm" decorative /></span>
                </Link>
                <figcaption>
                  <div><span class="screenshot-number">0{index + 1} / VS Code</span><h3>{screenshot.name}</h3></div>
                  <p>{screenshot.detail}</p>
                </figcaption>
              </figure>
            </TabsPanel>
          ))}
        </Tabs>
      </section>

      <section id="why" class="site-shell why-section">
        <div>
          <p class="eyebrow">Philosophy</p>
          <h2>Designed for hours, not screenshots.</h2>
          <p class="section-lede">Every decision in the palette came from a question: does this help you read code faster?</p>
        </div>
        <div class="why-grid">
          <Card as="article" variant="unstyled" class="why-card">
            <span class="why-number" aria-hidden="true">01</span>
            <h3>No neon</h3>
            <p>Muted violets keep the canvas quiet, with distinct accents for the parts of your code that need attention.</p>
          </Card>
          <Card as="article" variant="unstyled" class="why-card">
            <span class="why-number" aria-hidden="true">02</span>
            <h3>Keywords recede</h3>
            <p>Control-flow keywords are muted italic — present but quiet. Your identifiers and values carry the visual weight because they carry the logic.</p>
          </Card>
          <Card as="article" variant="unstyled" class="why-card">
            <span class="why-number" aria-hidden="true">03</span>
            <h3>Semantic-aware</h3>
            <p>Semantic highlighting is on by default. Class names, type parameters, and mutable variables get distinct shades — no extra config needed.</p>
          </Card>
          <Card as="article" variant="unstyled" class="why-card">
            <span class="why-number" aria-hidden="true">04</span>
            <h3>Terminal included</h3>
            <p>The 16 ANSI colors are calibrated to the same violet palette. Shell output reads like part of the editor, not an afterthought.</p>
          </Card>
        </div>
      </section>

      <section id="editors" class="site-shell editors-section">
        <div>
          <p class="eyebrow">Works with</p>
          <h2>Every VS Code-based editor.</h2>
          <p class="section-lede">Install once from the Marketplace or Open VSX — the theme loads in all editors built on VS Code's extension API.</p>
        </div>
        <div class="editor-chips">
          <Link class="editor-chip" href="https://marketplace.visualstudio.com/items?itemName=Santi020k.santi020k-theme" aria-label="Install in Visual Studio Code" newTab>
            <svg role="img" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="28" height="28"><path fill="currentColor" d="M23.15 2.587L18.21.21a1.494 1.494 0 0 0-1.705.29l-9.46 8.63-4.12-3.128a.999.999 0 0 0-1.276.057L.327 7.261A1 1 0 0 0 .326 8.74L3.899 12 .326 15.26a1 1 0 0 0 .001 1.479L1.65 17.94a.999.999 0 0 0 1.276.057l4.12-3.128 9.46 8.63a1.492 1.492 0 0 0 1.704.29l4.942-2.377A1.5 1.5 0 0 0 24 20.06V3.939a1.5 1.5 0 0 0-.85-1.352zm-5.146 14.861L10.826 12l7.178-5.448v10.896z"/></svg>
            <span>VS Code</span>
          </Link>
          <Link class="editor-chip" href="https://marketplace.visualstudio.com/items?itemName=Santi020k.santi020k-theme" aria-label="Install in Cursor" newTab>
            <svg role="img" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="28" height="28"><path fill="currentColor" d="M4.5 2.5L12 21.5L19.5 2.5H16L12 13.5L8 2.5H4.5Z"/></svg>
            <span>Cursor</span>
          </Link>
          <Link class="editor-chip" href="https://open-vsx.org/extension/santi020k/santi020k-theme" aria-label="Install in VSCodium" newTab>
            <svg role="img" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="28" height="28"><path fill="currentColor" d="M17.061.852a1.495 1.495 0 0 0-1.225.266L6.01 9.272l-4.137-3.13a1.009 1.009 0 0 0-1.278.057L.33 7.387a1.01 1.01 0 0 0 0 1.49L3.906 12 .33 15.123a1.01 1.01 0 0 0 0 1.49l.264.188a1.009 1.009 0 0 0 1.278.057l4.137-3.13 9.826 8.153a1.494 1.494 0 0 0 1.705.29l4.942-2.386A1.507 1.507 0 0 0 23.332 18V6a1.507 1.507 0 0 0-.85-1.355L17.54.975a1.46 1.46 0 0 0-.48-.123zm-1.09 16.32L9.208 12l6.764-5.172z"/></svg>
            <span>VSCodium</span>
          </Link>
          <Link class="editor-chip" href="https://marketplace.visualstudio.com/items?itemName=Santi020k.santi020k-theme" aria-label="Install in Windsurf" newTab>
            <svg role="img" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 18c3-6 7-10 12-10 2 0 4 .8 5 2"/><path d="M3 18c2-3 5-5 9-5 3 0 6 1 8 3"/><circle cx="12" cy="4" r="2"/></svg>
            <span>Windsurf</span>
          </Link>
          <Link class="editor-chip" href="https://marketplace.visualstudio.com/items?itemName=Santi020k.santi020k-theme" aria-label="Install in GitHub Codespaces" newTab>
            <svg role="img" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="28" height="28"><path fill="currentColor" d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
            <span>Codespaces</span>
          </Link>
          <Link class="editor-chip" href="https://open-vsx.org/extension/santi020k/santi020k-theme" aria-label="Install in Gitpod" newTab>
            <svg role="img" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="28" height="28"><path fill="currentColor" d="M23.988 11.774A12.148 12.148 0 0 0 12.045 0 12.06 12.06 0 0 0 1.726 6.302L8.89 19.335a3.64 3.64 0 0 0 6.356-.009l1.591-2.882L9.79 5.375a6.522 6.522 0 0 1 6.523.05 6.455 6.455 0 0 1 3.235 5.597 6.455 6.455 0 0 1-6.44 6.47c-.04 0-.084-.002-.126-.004l-1.575 2.854a9.406 9.406 0 0 0 .839.038c5.515 0 9.986-4.472 9.986-9.988 0-.206-.006-.41-.018-.613l-.006-.005Z"/></svg>
            <span>Gitpod</span>
          </Link>
          <Link class="editor-chip" href="https://marketplace.visualstudio.com/items?itemName=Santi020k.santi020k-theme" aria-label="Install in Positron" newTab>
            <svg role="img" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>
            <span>Positron</span>
          </Link>
        </div>
      </section>

      <section id="languages" class="site-shell languages-section">
        <div>
          <p class="eyebrow">Language coverage</p>
          <h2>Deep coverage for your stack.</h2>
          <p class="section-lede">TextMate and semantic colors for the languages, frameworks, and tools across your stack.</p>
        </div>
        <div class="language-grid">
          <div class="lang-tag"><span>TypeScript</span></div>
          <div class="lang-tag"><span>JavaScript</span></div>
          <div class="lang-tag"><span>React / Next.js</span></div>
          <div class="lang-tag"><span>Tailwind CSS</span></div>
          <div class="lang-tag"><span>Prisma</span></div>
          <div class="lang-tag"><span>Elixir</span></div>
          <div class="lang-tag"><span>Node.js / Vite</span></div>
          <div class="lang-tag"><span>Python</span></div>
          <div class="lang-tag"><span>Rust</span></div>
          <div class="lang-tag"><span>Go</span></div>
          <div class="lang-tag"><span>SQL / PostgreSQL</span></div>
          <div class="lang-tag"><span>HTML / CSS</span></div>
          <div class="lang-tag"><span>Svelte / Vue</span></div>
          <div class="lang-tag"><span>Shell / Docker</span></div>
        </div>

      </section>

      <section id="compatibility" class="site-shell compatibility-section">
        <div><p class="eyebrow">Compatibility</p><h2>Important editor surfaces are covered.</h2><p class="section-lede">The palette includes dedicated colors for modern VS Code workflows and popular extensions. The matrix is maintained with the theme validation fixtures.</p></div>
        <div class="compatibility-grid" role="list">
          {['GitLens', 'Error Lens', 'GitHub Pull Requests', 'Copilot Chat', 'Inline suggestions', 'Testing', 'Debugging', 'Notebooks', 'Remote development', 'Diff editor', 'Terminal', 'Notifications'].map(name => <div role="listitem"><span aria-hidden="true">✓</span><b>{name}</b></div>)}
        </div>
        <p class="evidence-links"><Link href="/vscode/accessibility-report.md">View accessibility evidence</Link> · <Link href="/vscode/compatibility.md">View compatibility details</Link></p>
      </section>

      <section id="settings" class="site-shell settings-section">
        <div><p class="eyebrow">Settings recipe</p><h2>Copy a complete theme setup.</h2><p class="section-lede">Choose a syntax style and optional OS switching. The recipe uses standard VS Code settings and keeps the extension itself lightweight.</p></div>
        <div class="settings-builder">
          <div class="settings-controls">
            <div class="settings-style-field"><label for="settings-style">Syntax style</label><Select id="settings-style" class="settings-style" aria-label="Settings syntax style" value="base" options={[{ value: 'base', label: 'Base' }, { value: 'bold', label: 'Bold' }, { value: 'italic', label: 'Italic' }]} /></div>
            <label><Checkbox class="settings-auto"  checked /> Follow the operating system light and dark mode</label>
            <label><Checkbox class="settings-font"  checked /> Include calm editor typography</label>
          </div>
          <div class="settings-output"><pre><code class="settings-code"></code></pre><Button class="button button-primary settings-copy" type="button">Copy settings</Button></div>
        </div>
      </section>

      <section id="palette" class="site-shell palette-section">
        <div>
          <p class="eyebrow">Palette</p>
          <h2>Violets for focus, soft contrast for long sessions.</h2>
        </div>
        <div class="swatches" aria-label="Core theme colors">
          <span style="--swatch: #110c1d">Indigo black</span>
          <span style="--swatch: #1c1528">Sidebar</span>
          <span style="--swatch: #5a0fdb">Control</span>
          <span style="--swatch: #945df4">Focus</span>
          <span style="--swatch: #b48df7">String</span>
          <span style="--swatch: #f8f6fd">Light canvas</span>
        </div>
      </section>
    </main>

    <SharedFooter />

    <script>
      import '../main.js'
    </script>
    <UIPrimitives />
  </body>
</html>
