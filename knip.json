{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": [
    "plutil",
    "swift",
    "validate",
    "nvim"
  ],
  "ignoreDependencies": [
    "@astrojs/check"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "package.json",
        "og.audit.config.mjs",
        "scripts/generate-og-images.mjs"
      ],
      "project": [
        "*.mjs",
        "scripts/**/*.mjs"
      ]
    },
    "apps/website": {
      "entry": [
        "src/pages/**/*.astro",
        "src/pages/**/*.ts"
      ],
      "project": [
        "src/**/*.astro",
        "src/**/*.js",
        "src/**/*.ts"
      ]
    },
    "apps/vscode-website": {
      "entry": [
        "package.json",
        "src/pages/*.astro"
      ],
      "project": [
        "scripts/**/*.mjs",
        "src/**/*.astro",
        "tests/**/*.mjs",
        "src/**/*.js"
      ]
    },
    "apps/chrome-website": {
      "entry": [
        "src/pages/*.astro"
      ],
      "project": [
        "src/**/*.astro",
        "src/**/*.js"
      ]
    },
    "apps/terminal-website": {
      "entry": ["package.json", "scripts/*.mjs", "src/pages/*.astro"],
      "ignoreDependencies": ["santi020k-terminal-theme"],
      "project": ["scripts/**/*.mjs", "src/**/*.astro", "src/**/*.js"]
    },
    "packages/santi020k-terminal-theme": {
      "entry": ["package.json"],
      "project": ["*.mjs", "scripts/**/*.mjs", "tests/**/*.mjs"]
    },
    "packages/santi020k-chrome-theme": {
      "entry": [
        "package.json"
      ],
      "project": [
        "scripts/**/*.mjs"
      ]
    },
    "packages/santi020k-theme": {
      "entry": [
        "package.json"
      ],
      "project": [
        "scripts/**/*.mjs",
        "tests/**/*.mjs"
      ]
    },
    "packages/theme": {
      "entry": [
        "package.json"
      ]
    },
    "packages/theme-core": {
      "entry": [
        "package.json"
      ]
    }
  }
}
